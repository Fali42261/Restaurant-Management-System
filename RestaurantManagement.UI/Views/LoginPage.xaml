<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="RestaurantManagement.UI.Views.LoginPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Sign in"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{AppThemeBinding Light=#F4F7FB, Dark=#10191D}">

    <ContentPage.Resources><Style TargetType="Entry"><Setter Property="HeightRequest" Value="48" /><Setter Property="FontSize" Value="15" /><Setter Property="HorizontalOptions" Value="Fill" /><Setter Property="VerticalOptions" Value="Center" /><Setter Property="Margin" Value="0" /><Setter Property="BackgroundColor" Value="Transparent" /></Style></ContentPage.Resources>
    <Grid><ScrollView>
        <Grid Padding="24" RowDefinitions="*,Auto,*">
            <VerticalStackLayout Grid.Row="1"
                                 Spacing="22"
                                 HorizontalOptions="Fill"
                                 MaximumWidthRequest="520"
                                 VerticalOptions="Center">
                <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                    <Label Text="swapDigit"
                           FontSize="29"
                           FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light=#172B27, Dark=#E7EFEB}"
                           HorizontalTextAlignment="Center" />
                    <Label Text="Welcome back. Sign in to continue."
                           FontSize="14"
                           TextColor="{AppThemeBinding Light=#718078, Dark=#AAB8B0}"
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>

                <Border BackgroundColor="{AppThemeBinding Light=White, Dark=#1B292E}"
                        Stroke="{AppThemeBinding Light=#E5EBE8, Dark=#34464B}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 24"
                        Padding="24">
                    <VerticalStackLayout Spacing="17">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Sign in"
                                   FontSize="23"
                                   FontAttributes="Bold"
                                   TextColor="#172B27" />
                            <Label Text="Enter your account details below."
                                   FontSize="13"
                                   TextColor="#788780" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="7">
                            <Label Text="Email or mobile number"
                                   FontSize="13"
                                   FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light=#344A43, Dark=#D9EFEC}" />
                            <Grid RowDefinitions="48,1" ColumnDefinitions="*" ColumnSpacing="0">
                                <Entry Grid.Row="0" BackgroundColor="Transparent" Placeholder="Enter your email or mobile number" Keyboard="Email" Text="{Binding EmailOrMobile}" TextColor="#172B27" PlaceholderColor="#9AA9A2" ClearButtonVisibility="WhileEditing" />
                                <BoxView Grid.Row="1" BackgroundColor="#B9C9C2" HeightRequest="1" HorizontalOptions="Fill" />
                            </Grid>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="7">
                            <Label Text="Password"
                                   FontSize="13"
                                   FontAttributes="Bold"
                                   TextColor="#344A43" />
                            <Grid RowDefinitions="48,1" ColumnDefinitions="*,44" ColumnSpacing="4">
                                <Entry x:Name="PasswordEntry" Grid.Row="0" Grid.Column="0" BackgroundColor="Transparent" Placeholder="Enter your password" IsPassword="True" Text="{Binding Password}" TextColor="#172B27" PlaceholderColor="#9AA9A2" />
                                <Image x:Name="PasswordEyeButton" Source="eye.png" Grid.Row="0" Grid.Column="1" WidthRequest="24" HeightRequest="24" Aspect="AspectFit" HorizontalOptions="Center" VerticalOptions="Center">
                                    <Image.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="TogglePasswordVisibility" />
                                    </Image.GestureRecognizers>
                                </Image>
                                <BoxView Grid.Row="1" Grid.ColumnSpan="2" BackgroundColor="#1F9AA5" HeightRequest="1.5" HorizontalOptions="Fill" />
                            </Grid>
                        </VerticalStackLayout>

                        <HorizontalStackLayout HorizontalOptions="End">
                            <Label Text="Change password" TextColor="#548F61" FontSize="13" FontAttributes="Bold">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding GoToChangePasswordCommand}" />
                                </Label.GestureRecognizers>
                            </Label>
                        </HorizontalStackLayout>

                        <Grid HeightRequest="52">
                            <Button Text="Sign in"
                                    Command="{Binding SignInCommand}"
                                    IsEnabled="{Binding CanSignIn}"
                                    BackgroundColor="#A8DDB0"
                                    TextColor="#244B32"
                                    FontAttributes="Bold"
                                    CornerRadius="12"
                                    HeightRequest="52" />
                            <ActivityIndicator IsRunning="{Binding IsBusy}"
                                               IsVisible="{Binding IsBusy}"
                                               Color="#244B32"
                                               HorizontalOptions="End"
                                               VerticalOptions="Center"
                                               Margin="0,0,22,0" />
                        </Grid>

                        <HorizontalStackLayout HorizontalOptions="Center"
                                               Spacing="5">
                            <Label Text="Restaurant owner?"
                                   TextColor="#718078"
                                   FontSize="13"
                                   VerticalTextAlignment="Center" />
                            <Label Text="Create owner account"
                                   TextColor="#1F6B57"
                                   FontSize="13"
                                   FontAttributes="Bold"
                                   VerticalTextAlignment="Center">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding GoToRegisterCommand}" />
                                </Label.GestureRecognizers>
                            </Label>
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <Label Text="Secure access for your restaurant team"
                       FontSize="12"
                       TextColor="#91A099"
                       HorizontalTextAlignment="Center" />
            </VerticalStackLayout>
        </Grid>
    </ScrollView></Grid>
</ContentPage>