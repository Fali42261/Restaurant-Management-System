<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="RestaurantManagement.UI.Views.LoginPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Sign in"
    Shell.NavBarIsVisible="False"
    BackgroundColor="#F4F7FB">

    <ContentPage.Resources><Style TargetType="Entry"><Setter Property="HeightRequest" Value="48" /><Setter Property="FontSize" Value="15" /><Setter Property="HorizontalOptions" Value="Fill" /><Setter Property="VerticalOptions" Value="Center" /><Setter Property="Margin" Value="0" /><Setter Property="BackgroundColor" Value="Transparent" /></Style></ContentPage.Resources>
    <Grid><ScrollView>
        <Grid Padding="24" RowDefinitions="*,Auto,*">
            <VerticalStackLayout Grid.Row="1"
                                 Spacing="22"
                                 HorizontalOptions="Center"
                                 MaximumWidthRequest="520"
                                 VerticalOptions="Center">
                <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                    <Label Text="SwapDigit"
                           FontSize="29"
                           FontAttributes="Bold"
                           TextColor="#172B27"
                           HorizontalTextAlignment="Center" />
                    <Label Text="Welcome back. Sign in to continue."
                           FontSize="14"
                           TextColor="#718078"
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>

                <Border BackgroundColor="White"
                        Stroke="#E5EBE8"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 24"
                        Padding="24">
                    <VerticalStackLayout Spacing="17">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Sign in"
                                   FontSize="23"
                                   FontAttributes="Bold"
                                   TextColor="#172B27" />
                            <Label Text="Enter your account details below."
                                   FontSize="13"
                                   TextColor="#788780" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="7">
                            <Label Text="Email or mobile number"
                                   FontSize="13"
                                   FontAttributes="Bold"
                                   TextColor="#344A43" />
                            <Border StrokeThickness="0" Padding="0">
                                <Entry BackgroundColor="Transparent" Placeholder="Enter your email or Mobile number"
                                       Keyboard="Email"
                                       Text="{Binding EmailOrMobile}"
                                       TextColor="#172B27"
                                       PlaceholderColor="#9AA9A2"
                                       ClearButtonVisibility="WhileEditing" />
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="7">
                            <Label Text="Password"
                                   FontSize="13"
                                   FontAttributes="Bold"
                                   TextColor="#344A43" />
                            <Border StrokeThickness="0" Padding="0">
                                <Grid ColumnDefinitions="*,Auto"><Entry x:Name="PasswordEntry" BackgroundColor="Transparent" Placeholder="Enter your password" IsPassword="True" Text="{Binding Password}" TextColor="#172B27" PlaceholderColor="#9AA9A2" /><ImageButton x:Name="PasswordEyeButton" Grid.Column="1" Source="eye.svg" Clicked="TogglePasswordVisibility" BackgroundColor="Transparent" WidthRequest="42" HeightRequest="42" Padding="9" Aspect="AspectFit" /></Grid>
                            </Border>
                        </VerticalStackLayout>

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                            <Label Grid.Column="1" Text="Change password" TextColor="#1F6B57" FontSize="13" FontAttributes="Bold" HorizontalTextAlignment="End">
                                <Label.GestureRecognizers><TapGestureRecognizer Command="{Binding GoToChangePasswordCommand}" /></Label.GestureRecognizers>
                            </Label>
                        </Grid>

                        <Button Text="Sign in"
                                Command="{Binding SignInCommand}"
                                BackgroundColor="#1F6B57"
                                TextColor="White"
                                FontAttributes="Bold"
                                CornerRadius="12"
                                HeightRequest="52" />

                        <HorizontalStackLayout HorizontalOptions="Center"
                                               Spacing="5">
                            <Label Text="Restaurant owner?"
                                   TextColor="#718078"
                                   FontSize="13"
                                   VerticalTextAlignment="Center" />
                            <Label Text="Create owner account"
                                   TextColor="#1F6B57"
                                   FontSize="13"
                                   FontAttributes="Bold"
                                   VerticalTextAlignment="Center">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding GoToRegisterCommand}" />
                                </Label.GestureRecognizers>
                            </Label>
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <Label Text="Secure access for your restaurant team"
                       FontSize="12"
                       TextColor="#91A099"
                       HorizontalTextAlignment="Center" />
            </VerticalStackLayout>
        </Grid>
    </ScrollView><Border IsVisible="{Binding HasStatusMessage}" BackgroundColor="#26332D" StrokeThickness="0" StrokeShape="RoundRectangle 12" Padding="14,10" HorizontalOptions="Center" VerticalOptions="Start" Margin="18,12,18,0" ZIndex="10"><Label Text="{Binding StatusMessage}" TextColor="White" FontSize="13" /></Border></Grid>
</ContentPage>