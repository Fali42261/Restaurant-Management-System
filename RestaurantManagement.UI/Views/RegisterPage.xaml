<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="RestaurantManagement.UI.Views.RegisterPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Create account"
    BackgroundColor="#F4F7FB">

    <ScrollView>
        <Grid Padding="24" RowDefinitions="*,Auto,*">
            <VerticalStackLayout Grid.Row="1"
                                 Spacing="18"
                                 HorizontalOptions="Center"
                                 MaximumWidthRequest="560"
                                 VerticalOptions="Center">
                <VerticalStackLayout Spacing="6" HorizontalOptions="Center">
                    <Label Text="Create your account"
                           FontSize="26"
                           FontAttributes="Bold"
                           TextColor="#172B27"
                           HorizontalTextAlignment="Center" />
                    <Label Text="Register as a restaurant staff member."
                           FontSize="14"
                           TextColor="#718078"
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>

                <Border BackgroundColor="White"
                        Stroke="#E5EBE8"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 24"
                        Padding="26">
                    <VerticalStackLayout Spacing="14">
                        <VerticalStackLayout Spacing="6">
                            <Label Text="Full name" FontSize="13" FontAttributes="Bold" TextColor="#344A43" />
                            <Border Stroke="#DCE5E0" StrokeThickness="1" StrokeShape="RoundRectangle 12" Padding="12,2">
                                <Entry Placeholder="Your full name" Text="{Binding FullName}" TextColor="#172B27" PlaceholderColor="#9AA9A2" />
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="6">
                            <Label Text="Email address" FontSize="13" FontAttributes="Bold" TextColor="#344A43" />
                            <Border Stroke="#DCE5E0" StrokeThickness="1" StrokeShape="RoundRectangle 12" Padding="12,2">
                                <Entry Placeholder="name@example.com" Keyboard="Email" Text="{Binding Email}" TextColor="#172B27" PlaceholderColor="#9AA9A2" />
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="6">
                            <Label Text="Mobile number (optional)" FontSize="13" FontAttributes="Bold" TextColor="#344A43" />
                            <Border Stroke="#DCE5E0" StrokeThickness="1" StrokeShape="RoundRectangle 12" Padding="12,2">
                                <Entry Placeholder="+91 98765 43210" Keyboard="Telephone" Text="{Binding MobileNumber}" TextColor="#172B27" PlaceholderColor="#9AA9A2" />
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="6">
                            <Label Text="Password" FontSize="13" FontAttributes="Bold" TextColor="#344A43" />
                            <Border Stroke="#DCE5E0" StrokeThickness="1" StrokeShape="RoundRectangle 12" Padding="12,2">
                                <Entry Placeholder="At least 8 characters" IsPassword="True" Text="{Binding Password}" TextColor="#172B27" PlaceholderColor="#9AA9A2" />
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="6">
                            <Label Text="Confirm password" FontSize="13" FontAttributes="Bold" TextColor="#344A43" />
                            <Border Stroke="#DCE5E0" StrokeThickness="1" StrokeShape="RoundRectangle 12" Padding="12,2">
                                <Entry Placeholder="Re-enter your password" IsPassword="True" Text="{Binding ConfirmPassword}" TextColor="#172B27" PlaceholderColor="#9AA9A2" />
                            </Border>
                        </VerticalStackLayout>

                        <Label Text="New accounts are created with the Staff role and may require approval."
                               FontSize="12"
                               TextColor="#718078" />

                        <Label Text="{Binding StatusMessage}"
                               TextColor="#B45309"
                               FontSize="13"
                               IsVisible="{Binding HasStatusMessage}" />

                        <Button Text="Create account"
                                Command="{Binding RegisterCommand}"
                                BackgroundColor="#1F6B57"
                                TextColor="White"
                                FontAttributes="Bold"
                                CornerRadius="12"
                                HeightRequest="52" />

                        <HorizontalStackLayout HorizontalOptions="Center" Spacing="5">
                            <Label Text="Already have an account?"
                                   TextColor="#718078"
                                   FontSize="13"
                                   VerticalTextAlignment="Center" />
                            <Label Text="Sign in"
                                   TextColor="#1F6B57"
                                   FontSize="13"
                                   FontAttributes="Bold"
                                   VerticalTextAlignment="Center">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding GoToLoginCommand}" />
                                </Label.GestureRecognizers>
                            </Label>
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </Grid>
    </ScrollView>
</ContentPage>