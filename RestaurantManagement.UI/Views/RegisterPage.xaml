<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="RestaurantManagement.UI.Views.RegisterPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Create account"
    Shell.NavBarIsVisible="False"
    BackgroundColor="#F4F7FB">
    <ContentPage.Resources>
        <Style TargetType="Entry">
            <Setter Property="HeightRequest" Value="48" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="BackgroundColor" Value="Transparent" />
            <Setter Property="VerticalOptions" Value="Center" />
            <Setter Property="Margin" Value="0" />
        </Style>
    </ContentPage.Resources>
    <Grid>
        <ScrollView>
            <Grid Padding="24" RowDefinitions="*,Auto,*">
                <VerticalStackLayout Grid.Row="1" Spacing="18" HorizontalOptions="Center" MaximumWidthRequest="520" VerticalOptions="Center">
                    <VerticalStackLayout Spacing="6" HorizontalOptions="Center">
                        <Label Text="Create owner account" FontSize="26" FontAttributes="Bold" TextColor="#172B27" HorizontalTextAlignment="Center" />
                        <Label Text="Register your restaurant as the owner." FontSize="14" TextColor="#718078" HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                    <Border BackgroundColor="White" Stroke="#E5EBE8" StrokeThickness="1" StrokeShape="RoundRectangle 24" Padding="24">
                        <VerticalStackLayout Spacing="14">
                            <VerticalStackLayout Spacing="5">
                                <Label Text="Full name" FontSize="13" FontAttributes="Bold" TextColor="#344A43" />
                                <Entry BackgroundColor="Transparent" Placeholder="Your full name" Text="{Binding FullName}" TextColor="#172B27" PlaceholderColor="#9AA9A2" />
                                
                            </VerticalStackLayout>
                            <VerticalStackLayout Spacing="5">
                                <Label Text="Email address" FontSize="13" FontAttributes="Bold" TextColor="#344A43" />
                                <Entry BackgroundColor="Transparent" Placeholder="name@example.com" Keyboard="Email" Text="{Binding Email}" TextColor="#172B27" PlaceholderColor="#9AA9A2" />
                                
                            </VerticalStackLayout>
                            <VerticalStackLayout Spacing="5">
                                <Label Text="Mobile number" FontSize="13" FontAttributes="Bold" TextColor="#344A43" />
                                <Entry BackgroundColor="Transparent" Placeholder="Enter your mobile number" Keyboard="Telephone" Text="{Binding MobileNumber}" TextColor="#172B27" PlaceholderColor="#9AA9A2" />
                                
                            </VerticalStackLayout>
                            <VerticalStackLayout Spacing="5">
                                <Label Text="Password" FontSize="13" FontAttributes="Bold" TextColor="#344A43" />
                                <Grid ColumnDefinitions="*,Auto"><Entry x:Name="PasswordEntry" BackgroundColor="Transparent" Placeholder="At least 8 characters" IsPassword="True" Text="{Binding Password}" TextColor="#172B27" PlaceholderColor="#9AA9A2" /><ImageButton Grid.Column="1" x:Name="PasswordEyeButton" Source="eye.svg" Clicked="TogglePasswordVisibility" BackgroundColor="Transparent" WidthRequest="42" HeightRequest="42" Padding="9" Aspect="AspectFit" /></Grid>
                                
                            </VerticalStackLayout>
                            <VerticalStackLayout Spacing="5">
                                <Label Text="Confirm password" FontSize="13" FontAttributes="Bold" TextColor="#344A43" />
                                <Grid ColumnDefinitions="*,Auto"><Entry x:Name="ConfirmPasswordEntry" BackgroundColor="Transparent" Placeholder="Re-enter your password" IsPassword="True" Text="{Binding ConfirmPassword}" TextColor="#172B27" PlaceholderColor="#9AA9A2" /><ImageButton Grid.Column="1" x:Name="ConfirmPasswordEyeButton" Source="eye.svg" Clicked="ToggleConfirmPasswordVisibility" BackgroundColor="Transparent" WidthRequest="42" HeightRequest="42" Padding="9" Aspect="AspectFit" /></Grid>
                                
                            </VerticalStackLayout>
                            <Label Text="Owner account registration. Staff members must sign in with credentials provided by the owner." FontSize="12" TextColor="#718078" />
                            <Button Text="Create account" Command="{Binding RegisterCommand}" BackgroundColor="#1F6B57" TextColor="White" FontAttributes="Bold" CornerRadius="12" HeightRequest="52" />
                            <HorizontalStackLayout HorizontalOptions="Center" Spacing="5">
                                <Label Text="Already have an account?" TextColor="#718078" FontSize="13" VerticalTextAlignment="Center" />
                                <Label Text="Sign in" TextColor="#1F6B57" FontSize="13" FontAttributes="Bold" VerticalTextAlignment="Center">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding GoToLoginCommand}" />
                                    </Label.GestureRecognizers>
                                </Label>
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>
            </Grid>
        </ScrollView>
        </Grid>
</ContentPage>