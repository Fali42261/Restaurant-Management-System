<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="RestaurantManagement.UI.Views.ChangePasswordPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Change password"
    Shell.NavBarIsVisible="False"
    BackgroundColor="#F4F7FB">
    <ContentPage.Resources>
        <Style TargetType="Entry">
            <Setter Property="HeightRequest" Value="48" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="BackgroundColor" Value="Transparent" />
            <Setter Property="VerticalOptions" Value="Center" />
            <Setter Property="Margin" Value="0" />
        </Style>
    </ContentPage.Resources>
    <Grid>
        <ScrollView>
            <VerticalStackLayout Padding="24" Spacing="20" HorizontalOptions="Center" VerticalOptions="Center" MaximumWidthRequest="520">
                <VerticalStackLayout Spacing="6">
                    <Label Text="SwapDigit" FontSize="29" FontAttributes="Bold" TextColor="#172B27" HorizontalTextAlignment="Center" />
                    <Label Text="Change your password" FontSize="25" FontAttributes="Bold" TextColor="#172B27" HorizontalTextAlignment="Center" />
                    <Label Text="Enter your current password and choose a new one." FontSize="14" TextColor="#718078" HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
                <Border BackgroundColor="White" Stroke="#E5EBE8" StrokeThickness="1" StrokeShape="RoundRectangle 24" Padding="24">
                    <VerticalStackLayout Spacing="14">
                        <VerticalStackLayout Spacing="5">
                            <Label Text="Current password" FontSize="13" FontAttributes="Bold" TextColor="#344A43" />
                            <Grid ColumnDefinitions="*,Auto">
                                <Entry x:Name="CurrentPasswordEntry" Placeholder="Enter current password" IsPassword="True" Text="{Binding CurrentPassword}" TextColor="#172B27" />
                                <ImageButton x:Name="CurrentPasswordEyeButton" Grid.Column="1" Source="eye.svg" Clicked="ToggleCurrentPassword" BackgroundColor="Transparent" WidthRequest="42" HeightRequest="42" Padding="9" />
                            </Grid>
                        </VerticalStackLayout>
                        <VerticalStackLayout Spacing="5">
                            <Label Text="New password" FontSize="13" FontAttributes="Bold" TextColor="#344A43" />
                            <Grid ColumnDefinitions="*,Auto">
                                <Entry x:Name="NewPasswordEntry" Placeholder="At least 8 characters" IsPassword="True" Text="{Binding NewPassword}" TextColor="#172B27" />
                                <ImageButton x:Name="NewPasswordEyeButton" Grid.Column="1" Source="eye.svg" Clicked="ToggleNewPassword" BackgroundColor="Transparent" WidthRequest="42" HeightRequest="42" Padding="9" />
                            </Grid>
                        </VerticalStackLayout>
                        <VerticalStackLayout Spacing="5">
                            <Label Text="Confirm new password" FontSize="13" FontAttributes="Bold" TextColor="#344A43" />
                            <Grid ColumnDefinitions="*,Auto">
                                <Entry x:Name="ConfirmPasswordEntry" Placeholder="Re-enter new password" IsPassword="True" Text="{Binding ConfirmPassword}" TextColor="#172B27" />
                                <ImageButton x:Name="ConfirmPasswordEyeButton" Grid.Column="1" Source="eye.svg" Clicked="ToggleConfirmPassword" BackgroundColor="Transparent" WidthRequest="42" HeightRequest="42" Padding="9" />
                            </Grid>
                        </VerticalStackLayout>
                        <Button Text="Update password" Command="{Binding ChangePasswordCommand}" BackgroundColor="#1F6B57" TextColor="White" FontAttributes="Bold" CornerRadius="12" HeightRequest="52" />
                        <Label Text="Back to sign in" TextColor="#1F6B57" FontSize="13" FontAttributes="Bold" HorizontalTextAlignment="Center">
                            <Label.GestureRecognizers><TapGestureRecognizer Command="{Binding GoToLoginCommand}" /></Label.GestureRecognizers>
                        </Label>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>
        <Border IsVisible="{Binding HasStatusMessage}" BackgroundColor="#26332D" StrokeThickness="0" StrokeShape="RoundRectangle 12" Padding="14,10" HorizontalOptions="Center" VerticalOptions="Start" Margin="18,12,18,0" ZIndex="10">
            <Label Text="{Binding StatusMessage}" TextColor="White" FontSize="13" />
        </Border>
    </Grid>
</ContentPage>