<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="RestaurantManagement.UI.Views.ChangePasswordPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Change password"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{AppThemeBinding Light=#F4F7FF, Dark=#0B1220}">
    <ContentPage.Resources>
        <Style TargetType="Entry">
            <Setter Property="HeightRequest" Value="48" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="BackgroundColor" Value="Transparent" />
            <Setter Property="VerticalOptions" Value="Center" />
            <Setter Property="Margin" Value="0" />
        </Style>
    </ContentPage.Resources>
    <Grid>
        <ScrollView>
            <VerticalStackLayout Padding="24" Spacing="20" HorizontalOptions="Center" VerticalOptions="Center" MaximumWidthRequest="520">
                <VerticalStackLayout Spacing="6">
                    <Label Text="SwapDigit" FontSize="29" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#172554, Dark=#EAF0FF}" HorizontalTextAlignment="Center" />
                    <Label Text="Change your password" FontSize="25" FontAttributes="Bold" TextColor="#172554" HorizontalTextAlignment="Center" />
                    <Label Text="Enter your current password and choose a new one." FontSize="14" TextColor="{AppThemeBinding Light=#64748B, Dark=#A9B9D5}" HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
                <Border BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#111C35}" Stroke="{AppThemeBinding Light=#DCE5F5, Dark=#263A5E}" StrokeThickness="1" StrokeShape="RoundRectangle 24" Padding="24">
                    <VerticalStackLayout Spacing="14">
                        <VerticalStackLayout Spacing="5">
                            <Label Text="Current password" FontSize="13" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#1E3A8A, Dark=#DCE6FF}" />
                            <Grid ColumnDefinitions="*,Auto">
                                <Entry x:Name="CurrentPasswordEntry" Placeholder="Enter current password" IsPassword="True" Text="{Binding CurrentPassword}" TextColor="#172554" />
                                <Image x:Name="CurrentPasswordEyeButton" Source="eye.png" Grid.Column="1" WidthRequest="24" HeightRequest="24" Aspect="AspectFit" HorizontalOptions="Center" VerticalOptions="Center">
                                    <Image.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="ToggleCurrentPassword" />
                                    </Image.GestureRecognizers>
                                </Image>
                            </Grid>
                        </VerticalStackLayout>
                        <VerticalStackLayout Spacing="5">
                            <Label Text="New password" FontSize="13" FontAttributes="Bold" TextColor="#1E3A8A" />
                            <Grid ColumnDefinitions="*,Auto">
                                <Entry x:Name="NewPasswordEntry" Placeholder="At least 8 characters" IsPassword="True" Text="{Binding NewPassword}" TextColor="#172554" />
                                <Image x:Name="NewPasswordEyeButton" Source="eye.png" Grid.Column="1" WidthRequest="24" HeightRequest="24" Aspect="AspectFit" HorizontalOptions="Center" VerticalOptions="Center">
                                    <Image.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="ToggleNewPassword" />
                                    </Image.GestureRecognizers>
                                </Image>
                            </Grid>
                        </VerticalStackLayout>
                        <VerticalStackLayout Spacing="5">
                            <Label Text="Confirm new password" FontSize="13" FontAttributes="Bold" TextColor="#1E3A8A" />
                            <Grid ColumnDefinitions="*,Auto">
                                <Entry x:Name="ConfirmPasswordEntry" Placeholder="Re-enter new password" IsPassword="True" Text="{Binding ConfirmPassword}" TextColor="#172554" />
                                <Image x:Name="ConfirmPasswordEyeButton" Source="eye.png" Grid.Column="1" WidthRequest="24" HeightRequest="24" Aspect="AspectFit" HorizontalOptions="Center" VerticalOptions="Center">
                                    <Image.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="ToggleConfirmPassword" />
                                    </Image.GestureRecognizers>
                                </Image>
                            </Grid>
                        </VerticalStackLayout>
                        <Button Text="Update password" Command="{Binding ChangePasswordCommand}" BackgroundColor="#2563EB" TextColor="White" FontAttributes="Bold" CornerRadius="12" HeightRequest="52" />
                        <Label Text="Back to sign in" TextColor="{AppThemeBinding Light=#2563EB, Dark=#93C5FD}" FontSize="13" FontAttributes="Bold" HorizontalTextAlignment="Center">
                            <Label.GestureRecognizers><TapGestureRecognizer Command="{Binding GoToLoginCommand}" /></Label.GestureRecognizers>
                        </Label>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>
        </Grid>
</ContentPage>