<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="RestaurantManagement.UI.Views.ResetPasswordPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Reset password"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{AppThemeBinding Light=#F4F7FB, Dark=#10191D}">
    <ContentPage.Resources><Style TargetType="Entry"><Setter Property="HeightRequest" Value="48" /><Setter Property="FontSize" Value="15" /><Setter Property="HorizontalOptions" Value="Fill" /><Setter Property="VerticalOptions" Value="Center" /><Setter Property="Margin" Value="0" /><Setter Property="BackgroundColor" Value="Transparent" /></Style></ContentPage.Resources>
    <Grid>
        <ScrollView>
            <VerticalStackLayout Padding="24" Spacing="20" HorizontalOptions="Center" VerticalOptions="Center" MaximumWidthRequest="520">
                <VerticalStackLayout Spacing="6">
                    <Label Text="SwapDigit" FontSize="29" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#172B27, Dark=#E7EFEB}" HorizontalTextAlignment="Center" />
                    <Label Text="Reset your password" FontSize="25" FontAttributes="Bold" TextColor="#172B27" HorizontalTextAlignment="Center" />
                    <Label Text="Enter your account email and choose a new password." FontSize="14" TextColor="{AppThemeBinding Light=#718078, Dark=#AAB8B0}" HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
                <Border BackgroundColor="{AppThemeBinding Light=White, Dark=#1B292E}" Stroke="{AppThemeBinding Light=#E5EBE8, Dark=#34464B}" StrokeThickness="1" StrokeShape="RoundRectangle 24" Padding="24">
                    <VerticalStackLayout Spacing="14">
                        <VerticalStackLayout Spacing="5">
                            <Label Text="Email address" FontSize="13" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#344A43, Dark=#D9EFEC}" />
                            <Entry Placeholder="name@example.com" Keyboard="Email" Text="{Binding Email}" TextColor="#172B27" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Spacing="5">
                            <Label Text="New password" FontSize="13" FontAttributes="Bold" TextColor="#344A43" />
                            <Grid ColumnDefinitions="*,Auto">
                                <Entry x:Name="NewPasswordEntry" Placeholder="At least 8 characters" IsPassword="True" Text="{Binding NewPassword}" TextColor="#172B27" />
                                <Image x:Name="NewPasswordEyeButton" Source="eye.png" Grid.Column="1" WidthRequest="24" HeightRequest="24" Aspect="AspectFit" HorizontalOptions="Center" VerticalOptions="Center">
                                    <Image.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="ToggleNewPassword" />
                                    </Image.GestureRecognizers>
                                </Image>
                            </Grid>
                        </VerticalStackLayout>
                        <VerticalStackLayout Spacing="5">
                            <Label Text="Confirm new password" FontSize="13" FontAttributes="Bold" TextColor="#344A43" />
                            <Grid ColumnDefinitions="*,Auto">
                                <Entry x:Name="ConfirmPasswordEntry" Placeholder="Re-enter new password" IsPassword="True" Text="{Binding ConfirmPassword}" TextColor="#172B27" />
                                <Image x:Name="ConfirmPasswordEyeButton" Source="eye.png" Grid.Column="1" WidthRequest="24" HeightRequest="24" Aspect="AspectFit" HorizontalOptions="Center" VerticalOptions="Center">
                                    <Image.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="ToggleConfirmPassword" />
                                    </Image.GestureRecognizers>
                                </Image>
                            </Grid>
                        </VerticalStackLayout>
                        <Button Text="Reset password" Command="{Binding ResetPasswordCommand}" BackgroundColor="#1F6B57" TextColor="White" FontAttributes="Bold" CornerRadius="12" HeightRequest="52" />
                        <Label Text="Back to sign in" TextColor="{AppThemeBinding Light=#1F6B57, Dark=#75C8C3}" FontSize="13" FontAttributes="Bold" HorizontalTextAlignment="Center">
                            <Label.GestureRecognizers><TapGestureRecognizer Command="{Binding GoToLoginCommand}" /></Label.GestureRecognizers>
                        </Label>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>
        </Grid>
</ContentPage>