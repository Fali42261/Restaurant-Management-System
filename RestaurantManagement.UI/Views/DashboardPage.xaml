<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="RestaurantManagement.UI.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Dashboard"
    BackgroundColor="#F3F5F4">

    <ContentPage.Resources>
        <ResourceDictionary>
            <Style x:Key="DashboardCardStyle" TargetType="Border">
                <Setter Property="BackgroundColor" Value="White" />
                <Setter Property="Stroke" Value="#E7EBE8" />
                <Setter Property="StrokeThickness" Value="1" />
                <Setter Property="StrokeShape">
                    <Setter.Value>
                        <RoundRectangle CornerRadius="13" />
                    </Setter.Value>
                </Setter>
                <Setter Property="Padding" Value="13" />
            </Style>
            <Style x:Key="NavButtonStyle" TargetType="Button">
                <Setter Property="BackgroundColor" Value="#173C43" />
                <Setter Property="TextColor" Value="#DCE9E8" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="HeightRequest" Value="48" />
                <Setter Property="HorizontalOptions" Value="Fill" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Padding" Value="12,8" />
                <Setter Property="VisualStateManager.VisualStateGroups">
                    <VisualStateGroupList><VisualStateGroup x:Name="CommonStates"><VisualState x:Name="Normal" /><VisualState x:Name="PointerOver"><VisualState.Setters><Setter Property="BackgroundColor" Value="#24616A" /><Setter Property="TextColor" Value="White" /></VisualState.Setters></VisualState></VisualStateGroup></VisualStateGroupList>
                </Setter>
            </Style>
            <Style x:Key="NavChipStyle" TargetType="Button">
                <Setter Property="BackgroundColor" Value="White" />
                <Setter Property="TextColor" Value="#075B63" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Padding" Value="12,8" />
            </Style>
            <Style x:Key="TinyPeriodButtonStyle" TargetType="Button">
                <Setter Property="BackgroundColor" Value="#F4F6F4" />
                <Setter Property="TextColor" Value="#66736B" />
                <Setter Property="CornerRadius" Value="5" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Padding" Value="8,5" />
                <Setter Property="HeightRequest" Value="24" />
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid x:Name="RootLayout" ColumnDefinitions="190,*" RowDefinitions="*">
        <!-- Desktop navigation -->
        <Grid x:Name="Sidebar" Grid.Column="0" RowDefinitions="Auto,*" BackgroundColor="#102F36" Padding="10,16,16,10">
            <VerticalStackLayout Spacing="3" Padding="8,4,4,18">
                <Label Text="swapDigit" FontSize="23" FontAttributes="Bold" TextColor="White" />
                <Label Text="RESTAURANT MANAGEMENT" FontSize="9" CharacterSpacing="1" TextColor="#A9C9C8" />
                <Label Text="My Restaurant" FontSize="12" FontAttributes="Bold" TextColor="#FFFFFF" Margin="0,5,0,0" />
            </VerticalStackLayout>
            <ScrollView Grid.Row="1" VerticalScrollBarVisibility="Never" Margin="0,0,0,0">
                <VerticalStackLayout Spacing="6">
                    <Button Text="▦  Tables Dashboard" Command="{Binding NavigateCommand}" CommandParameter="Tables" Style="{StaticResource NavButtonStyle}" />
                    <Button Text="▥  Business Dashboard" Command="{Binding NavigateCommand}" CommandParameter="Dashboard" Style="{StaticResource NavButtonStyle}" />
                    <Button Text="☷  POS Billing (F3)" Command="{Binding NavigateCommand}" CommandParameter="POS Billing" Style="{StaticResource NavButtonStyle}" />
                    <Button Text="★  Self Service (F4)" Command="{Binding NavigateCommand}" CommandParameter="Self Service" Style="{StaticResource NavButtonStyle}" />
                    <Button Text="♨  KOT (Kitchen)" Command="{Binding NavigateCommand}" CommandParameter="KOT" Style="{StaticResource NavButtonStyle}" />
                    <Button Text="◷  Reservations" Command="{Binding NavigateCommand}" CommandParameter="Reservations" Style="{StaticResource NavButtonStyle}" />
                    <Button Text="₹  Sales / Bills" Command="{Binding NavigateCommand}" CommandParameter="Sales / Bills" Style="{StaticResource NavButtonStyle}" />
                    <Button Text="▣  Store / Godown" Command="{Binding NavigateCommand}" CommandParameter="Store / Godown" Style="{StaticResource NavButtonStyle}" />
                    <Button Text="▤  Reports" Command="{Binding NavigateCommand}" CommandParameter="Reports" Style="{StaticResource NavButtonStyle}" />
                    <Button Text="▦  Floors &amp; Tables" Command="{Binding NavigateCommand}" CommandParameter="Floors &amp; Tables" Style="{StaticResource NavButtonStyle}" />
                    <Button Text="☷  Orders" Command="{Binding NavigateCommand}" CommandParameter="Orders" Style="{StaticResource NavButtonStyle}" />
                </VerticalStackLayout>
            </ScrollView>
        </Grid>
        <!-- Main content -->
        <Grid Grid.Column="1" RowDefinitions="58,52,*" RowSpacing="0">
            <Grid Grid.Row="0" BackgroundColor="White" Padding="12,6"
                  ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                <Label x:Name="WelcomeLabel" Text="Welcome back, Here's what's happening today."
                       FontSize="15" TextColor="#7A8580" VerticalTextAlignment="Center" />
                <Button x:Name="NotificationButton" Grid.Column="1" Text="🔔" Clicked="ToggleNotificationPopup"
                        BackgroundColor="Transparent" TextColor="#53635A" FontSize="19"
                        Padding="7,0" VerticalOptions="Center" />
                <Border x:Name="ProfilePanel" Grid.Column="2" StrokeThickness="0" BackgroundColor="#F1F5F1" StrokeShape="RoundRectangle 11" Padding="6,4" VerticalOptions="Center">
                    <Border.GestureRecognizers><TapGestureRecognizer Tapped="ToggleUserMenu" /></Border.GestureRecognizers>
                    <HorizontalStackLayout Spacing="7" VerticalOptions="Center">
                        <Border BackgroundColor="#DDEBD6" StrokeThickness="0" StrokeShape="RoundRectangle 16" WidthRequest="32" HeightRequest="32">
                            <Label Text="👤" FontSize="17" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                        </Border>
                        <VerticalStackLayout Spacing="0"><Label Text="Arthur" FontSize="13" FontAttributes="Bold" TextColor="#34433A" /><Label Text="Owner" FontSize="10" TextColor="#718078" /></VerticalStackLayout>
                        <Label Text="⌄" FontSize="15" TextColor="#65716A" VerticalTextAlignment="Center" />
                    </HorizontalStackLayout>
                </Border>
            </Grid>

            <ScrollView x:Name="MobileNavigation" Grid.Row="1" IsVisible="False" Orientation="Horizontal" HorizontalScrollBarVisibility="Never" BackgroundColor="#102F36">
                <HorizontalStackLayout Spacing="6" Padding="10,4">
                    <Button Text="Tables Dashboard" Command="{Binding NavigateCommand}" CommandParameter="Tables" Style="{StaticResource NavChipStyle}" />
                    <Button Text="Business Dashboard" Command="{Binding NavigateCommand}" CommandParameter="Dashboard" Style="{StaticResource NavChipStyle}" />
                    <Button Text="POS Billing (F3)" Command="{Binding NavigateCommand}" CommandParameter="POS Billing" Style="{StaticResource NavChipStyle}" />
                    <Button Text="Self Service (F4)" Command="{Binding NavigateCommand}" CommandParameter="Self Service" Style="{StaticResource NavChipStyle}" />
                    <Button Text="KOT (Kitchen)" Command="{Binding NavigateCommand}" CommandParameter="KOT" Style="{StaticResource NavChipStyle}" />
                    <Button Text="Reservations" Command="{Binding NavigateCommand}" CommandParameter="Reservations" Style="{StaticResource NavChipStyle}" />
                    <Button Text="Sales / Bills" Command="{Binding NavigateCommand}" CommandParameter="Sales / Bills" Style="{StaticResource NavChipStyle}" />
                    <Button Text="Store / Godown" Command="{Binding NavigateCommand}" CommandParameter="Store / Godown" Style="{StaticResource NavChipStyle}" />
                    <Button Text="Reports" Command="{Binding NavigateCommand}" CommandParameter="Reports" Style="{StaticResource NavChipStyle}" />
                    <Button Text="Floors &amp; Tables" Command="{Binding NavigateCommand}" CommandParameter="Floors &amp; Tables" Style="{StaticResource NavChipStyle}" />
                    <Button Text="Orders" Command="{Binding NavigateCommand}" CommandParameter="Orders" Style="{StaticResource NavChipStyle}" />
                </HorizontalStackLayout>
            </ScrollView>

            <ScrollView Grid.Row="2">
                <VerticalStackLayout Padding="16" Spacing="13">
                    <Label Text="{Binding SectionTitle}" IsVisible="{Binding IsOtherSection}" FontSize="26" FontAttributes="Bold" TextColor="#222D27" />
                    <VerticalStackLayout IsVisible="{Binding IsSettingsSection}" Spacing="14">
                        <VerticalStackLayout Spacing="3">
                            <Label Text="Settings" FontSize="26" FontAttributes="Bold" TextColor="#222D27" />
                            <Label Text="Manage your swapDigit restaurant workspace." FontSize="13" TextColor="#718078" />
                        </VerticalStackLayout>
                        <Border BackgroundColor="White" Stroke="#E7EBE8" StrokeThickness="1" StrokeShape="RoundRectangle 13" Padding="16">
                            <VerticalStackLayout Spacing="5">
                                <Label Text="Restaurant Profile" FontSize="17" FontAttributes="Bold" TextColor="#075B63" />
                                <Label Text="Restaurant name, contact details, address and business information." FontSize="13" TextColor="#718078" />
                            </VerticalStackLayout>
                        </Border>
                        <Border BackgroundColor="White" Stroke="#E7EBE8" StrokeThickness="1" StrokeShape="RoundRectangle 13" Padding="16">
                            <VerticalStackLayout Spacing="5">
                                <Label Text="Order &amp; Table Preferences" FontSize="17" FontAttributes="Bold" TextColor="#075B63" />
                                <Label Text="Table setup, order workflow, service preferences and kitchen settings." FontSize="13" TextColor="#718078" />
                            </VerticalStackLayout>
                        </Border>
                        <Border BackgroundColor="White" Stroke="#E7EBE8" StrokeThickness="1" StrokeShape="RoundRectangle 13" Padding="16">
                            <VerticalStackLayout Spacing="5">
                                <Label Text="Notifications" FontSize="17" FontAttributes="Bold" TextColor="#075B63" />
                                <Label Text="Alerts for new orders, reservations, kitchen updates and billing." FontSize="13" TextColor="#718078" />
                            </VerticalStackLayout>
                        </Border>
                        <Border BackgroundColor="White" Stroke="#E7EBE8" StrokeThickness="1" StrokeShape="RoundRectangle 13" Padding="16">
                            <VerticalStackLayout Spacing="5">
                                <Label Text="Account &amp; Security" FontSize="17" FontAttributes="Bold" TextColor="#075B63" />
                                <Label Text="Account information, password and staff access settings." FontSize="13" TextColor="#718078" />
                            </VerticalStackLayout>
                        </Border>
                        <Border BackgroundColor="#EAF4F2" Stroke="#CFE2DC" StrokeThickness="1" StrokeShape="RoundRectangle 13" Padding="16">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                <VerticalStackLayout Spacing="5">
                                    <Label Text="Subscription &amp; Plans" FontSize="17" FontAttributes="Bold" TextColor="#075B63" />
                                    <Label Text="View your 3-day free trial, compare plans and choose a subscription." FontSize="13" TextColor="#536159" />
                                </VerticalStackLayout>
                                <Button Grid.Column="1" Text="View Plans" Clicked="SubscriptionMenuClicked" BackgroundColor="#075B63" TextColor="White" FontSize="12" Padding="13,8" VerticalOptions="Center" />
                            </Grid>
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout IsVisible="{Binding IsSubscriptionSection}" Spacing="14">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Subscription Plans" FontSize="26" FontAttributes="Bold" TextColor="#222D27" />
                            <Label Text="Choose a plan for your restaurant and keep your business running smoothly." FontSize="13" TextColor="#718078" />
                        </VerticalStackLayout>
                        <Border BackgroundColor="#EAF4F2" Stroke="#CFE2DC" StrokeThickness="1" StrokeShape="RoundRectangle 14" Padding="16">
                            <VerticalStackLayout Spacing="7">
                                <Label Text="3 DAYS FREE TRIAL" FontSize="12" FontAttributes="Bold" CharacterSpacing="1" TextColor="#075B63" />
                                <Label Text="Try swapDigit free for 3 days" FontSize="20" FontAttributes="Bold" TextColor="#173C43" />
                                <Label Text="Explore restaurant management features during your trial. Select a paid plan before the trial ends to continue without interruption." FontSize="13" TextColor="#536159" />
                                <Label Text="Trial activation and expiry will be connected to your account after backend setup." FontSize="11" TextColor="#718078" />
                            </VerticalStackLayout>
                        </Border>
                        <Border BackgroundColor="White" Stroke="#DDE5DF" StrokeThickness="1" StrokeShape="RoundRectangle 14" Padding="16">
                            <VerticalStackLayout Spacing="7">
                                <Label Text="MONTHLY" FontSize="12" FontAttributes="Bold" TextColor="#075B63" />
                                <Label Text="₹399" FontSize="30" FontAttributes="Bold" TextColor="#173C43" />
                                <Label Text="per month • Flexible billing" FontSize="12" TextColor="#718078" />
                                <Label Text="Ideal for trying the full restaurant workflow with a low monthly commitment." FontSize="13" TextColor="#536159" />
                                <Button Text="Choose Monthly" Clicked="SubscriptionPlanClicked" CommandParameter="Monthly — ₹399/month" BackgroundColor="#EDF4F1" TextColor="#075B63" FontAttributes="Bold" />
                            </VerticalStackLayout>
                        </Border>
                        <Border BackgroundColor="White" Stroke="#075B63" StrokeThickness="2" StrokeShape="RoundRectangle 14" Padding="16">
                            <VerticalStackLayout Spacing="7">
                                <Label Text="MOST POPULAR" FontSize="11" FontAttributes="Bold" TextColor="#075B63" />
                                <Label Text="QUARTERLY" FontSize="12" FontAttributes="Bold" TextColor="#075B63" />
                                <Label Text="₹1,099" FontSize="30" FontAttributes="Bold" TextColor="#173C43" />
                                <Label Text="every 3 months • About ₹366/month" FontSize="12" TextColor="#718078" />
                                <Label Text="Save about 8% compared with paying monthly." FontSize="13" TextColor="#536159" />
                                <Button Text="Choose Quarterly" Clicked="SubscriptionPlanClicked" CommandParameter="Quarterly — ₹1,099 every 3 months" BackgroundColor="#075B63" TextColor="White" FontAttributes="Bold" />
                            </VerticalStackLayout>
                        </Border>
                        <Border BackgroundColor="White" Stroke="#DDE5DF" StrokeThickness="1" StrokeShape="RoundRectangle 14" Padding="16">
                            <VerticalStackLayout Spacing="7">
                                <Label Text="YEARLY" FontSize="12" FontAttributes="Bold" TextColor="#075B63" />
                                <Label Text="₹3,999" FontSize="30" FontAttributes="Bold" TextColor="#173C43" />
                                <Label Text="per year • About ₹333/month" FontSize="12" TextColor="#718078" />
                                <Label Text="Best value for restaurants planning to use swapDigit long term. Save about 16% compared with monthly billing." FontSize="13" TextColor="#536159" />
                                <Button Text="Choose Yearly" Clicked="SubscriptionPlanClicked" CommandParameter="Yearly — ₹3,999/year" BackgroundColor="#EDF4F1" TextColor="#075B63" FontAttributes="Bold" />
                            </VerticalStackLayout>
                        </Border>
                        <Label Text="Plan selection is a preview only. Online payment, automatic renewal, trial tracking and subscription-based access control are not active yet." FontSize="11" TextColor="#87938B" />
                    </VerticalStackLayout>

                    <VerticalStackLayout IsVisible="{Binding IsHelpSupportSection}" Spacing="14">
                        <VerticalStackLayout Spacing="3">
                            <Label Text="Help &amp; Support" FontSize="26" FontAttributes="Bold" TextColor="#222D27" />
                            <Label Text="Find help for using swapDigit." FontSize="13" TextColor="#718078" />
                        </VerticalStackLayout>
                        <Border BackgroundColor="White" Stroke="#E7EBE8" StrokeThickness="1" StrokeShape="RoundRectangle 13" Padding="16">
                            <VerticalStackLayout Spacing="6">
                                <Label Text="How can we help?" FontSize="18" FontAttributes="Bold" TextColor="#075B63" />
                                <Label Text="For assistance with tables, orders, kitchen tickets, reservations, billing and reports, contact your system administrator or swapDigit support team." FontSize="14" TextColor="#536159" />
                            </VerticalStackLayout>
                        </Border>
                        <Border BackgroundColor="White" Stroke="#E7EBE8" StrokeThickness="1" StrokeShape="RoundRectangle 13" Padding="16">
                            <VerticalStackLayout Spacing="5">
                                <Label Text="App information" FontSize="16" FontAttributes="Bold" TextColor="#075B63" />
                                <Label Text="swapDigit Restaurant Management" FontSize="13" TextColor="#536159" />
                                <Label Text="Help content and support contact details can be configured here." FontSize="12" TextColor="#718078" />
                            </VerticalStackLayout>
                        </Border>
                    </VerticalStackLayout>


                    <Border IsVisible="{Binding IsOtherSection}" BackgroundColor="White" Stroke="#E7EBE8" StrokeThickness="1" StrokeShape="RoundRectangle 14" Padding="22">
                        <VerticalStackLayout Spacing="10">
                            <Label Text="{Binding SectionTitle}" FontSize="22" FontAttributes="Bold" TextColor="#26332D" />
                            <Label Text="{Binding SectionDescription}" FontSize="15" TextColor="#7C8780" />
                            <Label Text="This section is ready for its UI module. Sample navigation is active; API and database integration will follow in the next phase." FontSize="16" TextColor="#7C8780" />
                        </VerticalStackLayout>
                    </Border>


                    <VerticalStackLayout x:Name="TableDashboard" IsVisible="{Binding IsTablesSection}" Spacing="13">
                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                            <Label Text="Floors &amp; Tables" FontSize="21" FontAttributes="Bold" TextColor="#075B63" />
                            <Button Grid.Column="1" Text="+ Add Floor" Clicked="AddFloorClicked" BackgroundColor="#075B63" TextColor="White" FontSize="12" Padding="12,6" />
                            <Grid Grid.Row="1" Grid.ColumnSpan="2" ColumnDefinitions="*,*,*,*" ColumnSpacing="8" Margin="0,10,0,0">
                                <Border BackgroundColor="#EAF0F1" StrokeThickness="0" Padding="10,7" StrokeShape="RoundRectangle 9"><Label Text="{Binding AvailableTableCount, StringFormat='Available {0}'}" TextColor="#536159" FontAttributes="Bold" /></Border>
                                <Border Grid.Column="1" BackgroundColor="#FFF3C0" StrokeThickness="0" Padding="10,7" StrokeShape="RoundRectangle 9"><Label Text="{Binding ReservedTableCount, StringFormat='Reserved {0}'}" TextColor="#8B6A13" FontAttributes="Bold" /></Border>
                                <Border Grid.Column="2" BackgroundColor="#DDEEFF" StrokeThickness="0" Padding="10,7" StrokeShape="RoundRectangle 9"><Label Text="{Binding ActiveTableCount, StringFormat='Running {0}'}" TextColor="#23658A" FontAttributes="Bold" /></Border>
                                <Border Grid.Column="3" BackgroundColor="#FCE6E4" StrokeThickness="0" Padding="10,7" StrokeShape="RoundRectangle 9"><Label Text="{Binding ReadyTableCount, StringFormat='Ready {0}'}" TextColor="#A7443D" FontAttributes="Bold" /></Border>
                            </Grid>
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Manage Floors" FontSize="17" FontAttributes="Bold" TextColor="#26332D" />
                            <Button Grid.Column="1" Text="+ Add Table" Clicked="AddTableClicked" BackgroundColor="#075B63" TextColor="White" FontSize="12" Padding="12,6" />
                        </Grid>
                        <FlexLayout BindableLayout.ItemsSource="{Binding Floors}" Wrap="Wrap" Direction="Row" JustifyContent="Start" AlignItems="Center">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate>
                                    <Border BackgroundColor="#EDF4F1" Stroke="#D8E5DE" StrokeThickness="1" StrokeShape="RoundRectangle 10" Padding="8,5" Margin="0,0,7,7">
                                        <HorizontalStackLayout Spacing="5">
                                            <Label Text="{Binding Name}" FontSize="12" FontAttributes="Bold" TextColor="#075B63" VerticalTextAlignment="Center"/>
                                            <Button Text="✎" Clicked="EditFloorClicked" BackgroundColor="Transparent" TextColor="#8B6A13" FontSize="12" Padding="4,2"/>
                                            <Button Text="✕" Clicked="DeleteFloorClicked" BackgroundColor="Transparent" TextColor="#B94B45" FontSize="12" Padding="4,2"/>
                                        </HorizontalStackLayout>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </FlexLayout>
                        <Label Text="Tables" FontSize="17" FontAttributes="Bold" TextColor="#26332D"/>
                        <FlexLayout x:Name="TableCardsFlex" BindableLayout.ItemsSource="{Binding Tables}" Wrap="Wrap" Direction="Row" JustifyContent="Start" AlignItems="Start">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate>
                                    <Border WidthRequest="235" Margin="0,0,10,10" BackgroundColor="{Binding CardColor}" Stroke="{Binding BorderBrush}" StrokeThickness="2" StrokeShape="RoundRectangle 13" Padding="12">
                                        <VerticalStackLayout Spacing="5">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <Label Text="{Binding Name}" FontSize="21" FontAttributes="Bold" TextColor="#26332D" />
                                                <Label Grid.Column="1" Text="{Binding Status}" FontSize="11" FontAttributes="Bold" TextColor="{Binding StatusColor}" VerticalTextAlignment="Center" />
                                            </Grid>
                                            <Label Text="{Binding AmountText}" FontSize="15" FontAttributes="Bold" TextColor="#26332D" />
                                            <Label Text="{Binding TimerText}" FontSize="12" TextColor="#536159" />
                                            <Label Text="{Binding FloorName}" FontSize="11" FontAttributes="Bold" TextColor="#075B63"/>
                                            <Label Text="{Binding DetailText}" FontSize="12" TextColor="#718078" />
                                            <Grid ColumnDefinitions="*,Auto,Auto,Auto" Margin="0,4,0,0" ColumnSpacing="4">
                                                <Label Text="{Binding SeatsText}" FontSize="12" TextColor="#536159" VerticalTextAlignment="Center" />
                                                <Button Grid.Column="1" Text="Edit" Clicked="EditTableClicked" BackgroundColor="#FFF3C0" TextColor="#805F0D" FontSize="10" Padding="7,4"/>
                                                <Button Grid.Column="2" Text="Delete" Clicked="DeleteTableClicked" BackgroundColor="#FCE6E4" TextColor="#A7443D" FontSize="10" Padding="7,4"/>
                                                <Button Grid.Column="3" Text="{Binding ActionText}" Clicked="TableActionClicked" BackgroundColor="#075B63" TextColor="White" FontSize="10" Padding="8,4" CornerRadius="7" />
                                            </Grid>
                                        </VerticalStackLayout>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </FlexLayout>
                    </VerticalStackLayout>

                    <VerticalStackLayout x:Name="OrdersDashboard" IsVisible="{Binding IsOrdersSection}" Spacing="12">
                        <Grid ColumnDefinitions="*,Auto">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="Orders Management" FontSize="23" FontAttributes="Bold" TextColor="#26332D" />
                                <Label Text="Create, view, update and remove restaurant orders." FontSize="13" TextColor="#718078" />
                            </VerticalStackLayout>
                            <Button Grid.Column="1" Text="+ Add Order" Clicked="AddOrderClicked" BackgroundColor="#075B63" TextColor="White" FontAttributes="Bold" Padding="15,8" />
                        </Grid>
                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="9">
                            <Border BackgroundColor="#EAF0F1" StrokeThickness="0" Padding="12" StrokeShape="RoundRectangle 10"><VerticalStackLayout><Label Text="TOTAL ORDERS" FontSize="11" TextColor="#718078"/><Label Text="{Binding TotalOrderCount}" FontSize="22" FontAttributes="Bold" TextColor="#26332D"/></VerticalStackLayout></Border>
                            <Border Grid.Column="1" BackgroundColor="#FFF3C0" StrokeThickness="0" Padding="12" StrokeShape="RoundRectangle 10"><VerticalStackLayout><Label Text="IN PROGRESS" FontSize="11" TextColor="#8B6A13"/><Label Text="{Binding ActiveOrderCount}" FontSize="22" FontAttributes="Bold" TextColor="#8B6A13"/></VerticalStackLayout></Border>
                            <Border Grid.Column="2" BackgroundColor="#E1F3E6" StrokeThickness="0" Padding="12" StrokeShape="RoundRectangle 10"><VerticalStackLayout><Label Text="COMPLETED" FontSize="11" TextColor="#368C55"/><Label Text="{Binding CompletedOrderCount}" FontSize="22" FontAttributes="Bold" TextColor="#368C55"/></VerticalStackLayout></Border>
                        </Grid>
                        <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never"><VerticalStackLayout BindableLayout.ItemsSource="{Binding Orders}" Spacing="8">
                            <BindableLayout.EmptyView><Label Text="No orders yet. Select Add Order to create one." TextColor="#718078" Padding="12"/></BindableLayout.EmptyView>
                            <BindableLayout.ItemTemplate>
                                <DataTemplate>
                                    <Border BackgroundColor="White" Stroke="#E7EBE8" StrokeThickness="1" StrokeShape="RoundRectangle 11" Padding="12">
                                        <Grid WidthRequest="850" ColumnDefinitions="1.1*,1.2*,0.7*,0.9*,Auto" ColumnSpacing="8">
                                            <VerticalStackLayout Spacing="2"><Label Text="{Binding OrderNumber}" FontAttributes="Bold" TextColor="#26332D"/><Label Text="{Binding ItemSummary}" FontSize="11" TextColor="#718078"/></VerticalStackLayout>
                                            <VerticalStackLayout Grid.Column="1" Spacing="2"><Label Text="{Binding TableName}" TextColor="#45534A"/><Label Text="{Binding CreatedText}" FontSize="11" TextColor="#718078"/></VerticalStackLayout>
                                            <Label Grid.Column="2" Text="{Binding QuantityText}" VerticalTextAlignment="Center" TextColor="#45534A"/>
                                            <Label Grid.Column="3" Text="{Binding Status}" VerticalTextAlignment="Center" FontAttributes="Bold" FontSize="12" TextColor="#075B63"/>
                                            <HorizontalStackLayout Grid.Column="4" Spacing="3" VerticalOptions="Center">
                                                <Button Text="View" Clicked="ViewOrderClicked" FontSize="11" Padding="8,5" BackgroundColor="#EAF0F1" TextColor="#075B63"/>
                                                <Button Text="Edit" Clicked="EditOrderClicked" FontSize="11" Padding="8,5" BackgroundColor="#FFF3C0" TextColor="#805F0D"/>
                                                <Button Text="Delete" Clicked="DeleteOrderClicked" FontSize="11" Padding="8,5" BackgroundColor="#FCE6E4" TextColor="#A7443D"/>
                                            </HorizontalStackLayout>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout></ScrollView>
                    </VerticalStackLayout>

                    <!-- KPI cards -->
                    <Grid x:Name="StatsGrid" IsVisible="{Binding IsDashboardSection}" ColumnDefinitions="*,*,*,*" RowDefinitions="Auto,Auto" ColumnSpacing="9" RowSpacing="9">
                        <Border Grid.Column="0" Style="{StaticResource DashboardCardStyle}">
                            <VerticalStackLayout Spacing="7">
                                <Label Text="TODAY'S REVENUE" FontSize="15" CharacterSpacing="0.8" TextColor="#7C8780" />
                                <Label Text="₹12,304" FontSize="27" TextColor="#202923" />
                                <Label Text="↗  3.5%  than last day" FontSize="15" TextColor="#368C55" />
                            </VerticalStackLayout>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource DashboardCardStyle}">
                            <VerticalStackLayout Spacing="7">
                                <Label Text="ACTIVE ORDERS" FontSize="15" CharacterSpacing="0.8" TextColor="#7C8780" />
                                <Label Text="24" FontSize="27" TextColor="#202923" />
                                <HorizontalStackLayout Spacing="7">
                                    <Label Text="16 Online" FontSize="15" TextColor="#368C55" />
                                    <Label Text="7 Dine-in" FontSize="15" TextColor="#7B8580" />
                                    <Label Text="1 Takeaway" FontSize="15" TextColor="#7B8580" />
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                        </Border>
                        <Border Grid.Column="2" Style="{StaticResource DashboardCardStyle}">
                            <VerticalStackLayout Spacing="7">
                                <Label Text="TABLES OCCUPIED" FontSize="15" CharacterSpacing="0.8" TextColor="#7C8780" />
