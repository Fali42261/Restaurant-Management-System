<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="RestaurantManagement.UI.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Dashboard"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{AppThemeBinding Light=#F4F7FF, Dark=#0B1220}">

    <ContentPage.Resources>
        <ResourceDictionary>
            <Style x:Key="DashboardCardStyle" TargetType="Border">
                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#FFFFFF, Dark=#111C35}" />
                <Setter Property="Stroke" Value="{AppThemeBinding Light=#DCE5F5, Dark=#263A5E}" />
                <Setter Property="StrokeThickness" Value="1" />
                <Setter Property="StrokeShape">
                    <Setter.Value>
                        <RoundRectangle CornerRadius="13" />
                    </Setter.Value>
                </Setter>
                <Setter Property="Padding" Value="13" />
            </Style>
            <Style x:Key="NavButtonStyle" TargetType="Button">
                <Setter Property="BackgroundColor" Value="#142342" />
                <Setter Property="TextColor" Value="#DCE6FF" />
                <Setter Property="BorderColor" Value="#142342" />
                <Setter Property="BorderWidth" Value="0" />
                <Setter Property="CornerRadius" Value="9" />
                <Setter Property="HeightRequest" Value="44" />
                <Setter Property="HorizontalOptions" Value="Fill" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Padding" Value="12,8" />
                <Setter Property="VisualStateManager.VisualStateGroups">
                    <VisualStateGroupList><VisualStateGroup x:Name="CommonStates"><VisualState x:Name="Normal" /><VisualState x:Name="PointerOver"><VisualState.Setters><Setter Property="BackgroundColor" Value="#2563EB" /><Setter Property="TextColor" Value="White" /></VisualState.Setters></VisualState></VisualStateGroup></VisualStateGroupList>
                </Setter>
            </Style>
            <Style x:Key="NavChipStyle" TargetType="Button">
                <Setter Property="BackgroundColor" Value="#E8EEFF" />
                <Setter Property="TextColor" Value="#1E3A8A" />
                <Setter Property="BorderColor" Value="#E8EEFF" />
                <Setter Property="BorderWidth" Value="0" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Padding" Value="12,8" />
            </Style>
            <Style x:Key="TinyPeriodButtonStyle" TargetType="Button">
                <Setter Property="BackgroundColor" Value="#EEF2FF" />
                <Setter Property="TextColor" Value="#64748B" />
                <Setter Property="CornerRadius" Value="5" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Padding" Value="8,5" />
                <Setter Property="HeightRequest" Value="24" />
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid x:Name="RootLayout" ColumnDefinitions="190,*" RowDefinitions="*" BackgroundColor="{AppThemeBinding Light=#F4F7FF, Dark=#0B1220}">
        <!-- Desktop navigation -->
        <Grid x:Name="Sidebar" Grid.Column="0" RowDefinitions="Auto,*" BackgroundColor="#0B1220" Padding="12,20,12,12">
            <VerticalStackLayout Spacing="3" Padding="8,4,4,18">
                <Label Text="swapDigit" FontSize="24" FontAttributes="Bold" TextColor="#FFFFFF" />
                <Label Text="RESTAURANT MANAGEMENT" FontSize="9" CharacterSpacing="1.2" TextColor="#8FA6D6" />
                <Label x:Name="SidebarRestaurantName" Text="My Restaurant" FontSize="12" FontAttributes="Bold" TextColor="#DCE6FF" Margin="0,7,0,0" />
            </VerticalStackLayout>
            <ScrollView Grid.Row="1" VerticalScrollBarVisibility="Never" Margin="0,0,0,0">
                <VerticalStackLayout Spacing="7">
                    <Border StrokeThickness="0" StrokeShape="RoundRectangle 9" BackgroundColor="#142342" HeightRequest="42" Padding="10,0">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding NavigateCommand}" CommandParameter="Dashboard" />
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="26,*" ColumnSpacing="8">
                            <Label Text="▥" FontSize="16" TextColor="#DCE6FF" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                            <Label Grid.Column="1" Text="Dashboard" FontSize="13" TextColor="#DCE6FF" VerticalTextAlignment="Center" LineBreakMode="TailTruncation" />
                        </Grid>
                    </Border>
                    <Border StrokeThickness="0" StrokeShape="RoundRectangle 9" BackgroundColor="#142342" HeightRequest="42" Padding="10,0">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding NavigateCommand}" CommandParameter="POS Billing" />
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="26,*" ColumnSpacing="8">
                            <Label Text="▤" FontSize="16" TextColor="#DCE6FF" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                            <Label Grid.Column="1" Text="POS / Billing" FontSize="13" TextColor="#DCE6FF" VerticalTextAlignment="Center" LineBreakMode="TailTruncation" />
                        </Grid>
                    </Border>
                    <Border StrokeThickness="0" StrokeShape="RoundRectangle 9" BackgroundColor="#142342" HeightRequest="42" Padding="10,0">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding NavigateCommand}" CommandParameter="Orders" />
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="26,*" ColumnSpacing="8">
                            <Label Text="☷" FontSize="16" TextColor="#DCE6FF" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                            <Label Grid.Column="1" Text="Orders" FontSize="13" TextColor="#DCE6FF" VerticalTextAlignment="Center" LineBreakMode="TailTruncation" />
                        </Grid>
                    </Border>
                    <Border StrokeThickness="0" StrokeShape="RoundRectangle 9" BackgroundColor="#142342" HeightRequest="42" Padding="10,0">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding NavigateCommand}" CommandParameter="KOT" />
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="26,*" ColumnSpacing="8">
                            <Label Text="♨" FontSize="16" TextColor="#DCE6FF" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                            <Label Grid.Column="1" Text="KOT" FontSize="13" TextColor="#DCE6FF" VerticalTextAlignment="Center" LineBreakMode="TailTruncation" />
                        </Grid>
                    </Border>
                    <Border StrokeThickness="0" StrokeShape="RoundRectangle 9" BackgroundColor="#142342" HeightRequest="42" Padding="10,0">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding NavigateCommand}" CommandParameter="Reservations" />
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="26,*" ColumnSpacing="8">
                            <Label Text="◷" FontSize="16" TextColor="#DCE6FF" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                            <Label Grid.Column="1" Text="Reservations" FontSize="13" TextColor="#DCE6FF" VerticalTextAlignment="Center" LineBreakMode="TailTruncation" />
                        </Grid>
                    </Border>
                    <Border StrokeThickness="0" StrokeShape="RoundRectangle 9" BackgroundColor="#142342" HeightRequest="42" Padding="10,0">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding NavigateCommand}" CommandParameter="Tables" />
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="26,*" ColumnSpacing="8">
                            <Label Text="▦" FontSize="16" TextColor="#DCE6FF" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                            <Label Grid.Column="1" Text="Table Management" FontSize="13" TextColor="#DCE6FF" VerticalTextAlignment="Center" LineBreakMode="TailTruncation" />
                        </Grid>
                    </Border>
                    <Border StrokeThickness="0" StrokeShape="RoundRectangle 9" BackgroundColor="#142342" HeightRequest="42" Padding="10,0">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding NavigateCommand}" CommandParameter="Menu Management" />
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="26,*" ColumnSpacing="8">
                            <Label Text="☰" FontSize="16" TextColor="#DCE6FF" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                            <Label Grid.Column="1" Text="Menu Management" FontSize="13" TextColor="#DCE6FF" VerticalTextAlignment="Center" LineBreakMode="TailTruncation" />
                        </Grid>
                    </Border>
                    <Border StrokeThickness="0" StrokeShape="RoundRectangle 9" BackgroundColor="#142342" HeightRequest="42" Padding="10,0">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding NavigateCommand}" CommandParameter="Customers" />
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="26,*" ColumnSpacing="8">
                            <Label Text="♙" FontSize="16" TextColor="#DCE6FF" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                            <Label Grid.Column="1" Text="Customers" FontSize="13" TextColor="#DCE6FF" VerticalTextAlignment="Center" LineBreakMode="TailTruncation" />
                        </Grid>
                    </Border>
                    <Border StrokeThickness="0" StrokeShape="RoundRectangle 9" BackgroundColor="#142342" HeightRequest="42" Padding="10,0">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding NavigateCommand}" CommandParameter="Staff Management" />
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="26,*" ColumnSpacing="8">
                            <Label Text="♟" FontSize="16" TextColor="#DCE6FF" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                            <Label Grid.Column="1" Text="Staff Management" FontSize="13" TextColor="#DCE6FF" VerticalTextAlignment="Center" LineBreakMode="TailTruncation" />
                        </Grid>
                    </Border>
                    <Border StrokeThickness="0" StrokeShape="RoundRectangle 9" BackgroundColor="#142342" HeightRequest="42" Padding="10,0">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding NavigateCommand}" CommandParameter="Inventory" />
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="26,*" ColumnSpacing="8">
                            <Label Text="▣" FontSize="16" TextColor="#DCE6FF" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                            <Label Grid.Column="1" Text="Inventory" FontSize="13" TextColor="#DCE6FF" VerticalTextAlignment="Center" LineBreakMode="TailTruncation" />
                        </Grid>
                    </Border>
                    <Border StrokeThickness="0" StrokeShape="RoundRectangle 9" BackgroundColor="#142342" HeightRequest="42" Padding="10,0">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding NavigateCommand}" CommandParameter="Reports" />
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="26,*" ColumnSpacing="8">
                            <Label Text="▤" FontSize="16" TextColor="#DCE6FF" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                            <Label Grid.Column="1" Text="Reports" FontSize="13" TextColor="#DCE6FF" VerticalTextAlignment="Center" LineBreakMode="TailTruncation" />
                        </Grid>
                    </Border>
                </VerticalStackLayout>
            </ScrollView>
        </Grid>
        <!-- Main content -->
        <Grid Grid.Column="1" RowDefinitions="58,52,*" RowSpacing="0" BackgroundColor="{AppThemeBinding Light=#F4F7FF, Dark=#0B1220}">
            <Grid Grid.Row="0" BackgroundColor="{AppThemeBinding Light=White, Dark=#111C35}" Padding="12,6"
                  ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8">
                <Label x:Name="WelcomeLabel" Text="Welcome back, Here's what's happening today."
                       FontSize="15" TextColor="{AppThemeBinding Light=#64748B, Dark=#A9B9D5}" VerticalTextAlignment="Center" />
                <Label x:Name="RestaurantSingleName" Grid.Column="2" Text="Restaurant" FontSize="13" FontAttributes="Bold" TextColor="#2563EB" VerticalTextAlignment="Center" IsVisible="False" />
                <Picker x:Name="RestaurantPicker" Grid.Column="2" Title="Select restaurant" WidthRequest="190" FontSize="13" TextColor="#2563EB" VerticalOptions="Center" IsVisible="False" SelectedIndexChanged="RestaurantPickerChanged" />
                <Button x:Name="NotificationButton" Grid.Column="1" Text="🔔" Clicked="ToggleNotificationPopup"
                        BackgroundColor="Transparent" TextColor="#475569" FontSize="19"
                        Padding="7,0" VerticalOptions="Center" />
                <Border x:Name="ProfilePanel" Grid.Column="3" StrokeThickness="0" BackgroundColor="{AppThemeBinding Light=#EEF2FF, Dark=#172554}" StrokeShape="RoundRectangle 11" Padding="6,4" VerticalOptions="Center">
                    <Border.GestureRecognizers><TapGestureRecognizer Tapped="ToggleUserMenu" /></Border.GestureRecognizers>
                    <HorizontalStackLayout Spacing="7" VerticalOptions="Center">
                        <Border BackgroundColor="#DBEAFE" StrokeThickness="0" StrokeShape="RoundRectangle 16" WidthRequest="32" HeightRequest="32">
                            <Label Text="👤" FontSize="17" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                        </Border>
                        <VerticalStackLayout Spacing="0"><Label x:Name="ProfileName" Text="User" FontSize="13" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#1E293B, Dark=#EAF0FF}" /><Label x:Name="ProfileRole" Text="Owner" FontSize="10" TextColor="{AppThemeBinding Light=#64748B, Dark=#A9B9D5}" /></VerticalStackLayout>
                        <Label Text="⌄" FontSize="15" TextColor="#65716A" VerticalTextAlignment="Center" />
                    </HorizontalStackLayout>
                </Border>
            </Grid>

            <ScrollView x:Name="MobileNavigation" Grid.Row="1" IsVisible="False" Orientation="Horizontal" HorizontalScrollBarVisibility="Never" BackgroundColor="{AppThemeBinding Light=#E8EEFF, Dark=#111C35}">
                <HorizontalStackLayout Spacing="6" Padding="10,4">
                    <Button Text="Dashboard" Command="{Binding NavigateCommand}" CommandParameter="Dashboard" Style="{StaticResource NavChipStyle}" />
                    <Button Text="POS / Billing" Command="{Binding NavigateCommand}" CommandParameter="POS Billing" Style="{StaticResource NavChipStyle}" />
                    <Button Text="Orders" Command="{Binding NavigateCommand}" CommandParameter="Orders" Style="{StaticResource NavChipStyle}" />
                    <Button Text="KOT" Command="{Binding NavigateCommand}" CommandParameter="KOT" Style="{StaticResource NavChipStyle}" />
                    <Button Text="Reservations" Command="{Binding NavigateCommand}" CommandParameter="Reservations" Style="{StaticResource NavChipStyle}" />
                    <Button Text="Table Management" Command="{Binding NavigateCommand}" CommandParameter="Tables" Style="{StaticResource NavChipStyle}" />
                    <Button Text="Menu Management" Command="{Binding NavigateCommand}" CommandParameter="Menu Management" Style="{StaticResource NavChipStyle}" />
                    <Button Text="Customers" Command="{Binding NavigateCommand}" CommandParameter="Customers" Style="{StaticResource NavChipStyle}" />
                    <Button Text="Staff Management" Command="{Binding NavigateCommand}" CommandParameter="Staff Management" Style="{StaticResource NavChipStyle}" />
                    <Button Text="Inventory" Command="{Binding NavigateCommand}" CommandParameter="Inventory" Style="{StaticResource NavChipStyle}" />
                    <Button Text="Reports" Command="{Binding NavigateCommand}" CommandParameter="Reports" Style="{StaticResource NavChipStyle}" />
                </HorizontalStackLayout>            </ScrollView>

            <ScrollView Grid.Row="2" BackgroundColor="{AppThemeBinding Light=#F4F7FF, Dark=#0B1220}">
                <VerticalStackLayout Padding="16" Spacing="13" BackgroundColor="{AppThemeBinding Light=#F4F7FF, Dark=#0B1220}">
                    <Label Text="{Binding SectionTitle}" IsVisible="{Binding IsOtherSection}" FontSize="26" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#0F1F45, Dark=#EAF0FF}" />
                    <VerticalStackLayout IsVisible="{Binding IsPosBillingSection}" Spacing="14">
                        <VerticalStackLayout Spacing="3">
                            <Label Text="POS Billing" FontSize="25" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#0F1F45, Dark=#EAF0FF}" />
                            <Label Text="Build an itemised bill, apply discount and tax, collect payment and create an invoice." FontSize="13" TextColor="{AppThemeBinding Light=#718078, Dark=#A9B9D5}" />
                        </VerticalStackLayout>
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <Border BackgroundColor="{AppThemeBinding Light=#EAF0FF, Dark=#1A2B4A}" StrokeThickness="0" StrokeShape="RoundRectangle 11" Padding="12">
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="CART SUBTOTAL" FontSize="10" TextColor="#1D4ED8"/>
                                    <Label Text="{Binding PosSubtotalText}" FontSize="23" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#2563EB, Dark=#93C5FD}"/>
                                </VerticalStackLayout>
                            </Border>
                            <Border Grid.Column="1" BackgroundColor="{AppThemeBinding Light=#EEF2FF, Dark=#172554}" StrokeThickness="0" StrokeShape="RoundRectangle 11" Padding="12" VerticalOptions="Fill">
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="ITEMS" FontSize="10" TextColor="{AppThemeBinding Light=#718078, Dark=#A9B9D5}"/>
                                    <Label Text="{Binding PosCartCountText}" FontSize="18" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#172554, Dark=#EAF0FF}"/>
                                </VerticalStackLayout>
                            </Border>
                        </Grid>
                        <Label Text="Menu Items" FontSize="18" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#172554, Dark=#EAF0FF}"/>
                        <CollectionView ItemsSource="{Binding SelfServiceProducts}" SelectionMode="None">
                            <CollectionView.ItemsLayout><GridItemsLayout Orientation="Vertical" Span="2" HorizontalItemSpacing="9" VerticalItemSpacing="9"/></CollectionView.ItemsLayout>
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Border BackgroundColor="{AppThemeBinding Light=White, Dark=#111C35}" Stroke="{AppThemeBinding Light=#DCE5F5, Dark=#34464B}" StrokeThickness="1" StrokeShape="RoundRectangle 12" Padding="11">
                                        <VerticalStackLayout Spacing="5">
                                            <Label Text="{Binding Category}" FontSize="10" TextColor="#1D4ED8"/>
                                            <Label Text="{Binding Name}" FontSize="14" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#172554, Dark=#EAF0FF}"/>
                                            <Label Text="{Binding PriceText}" FontSize="14" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#2563EB, Dark=#93C5FD}"/>
                                            <Button Text="Add to Bill +" Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.AddPosToCartCommand}" CommandParameter="{Binding Name}" BackgroundColor="#2563EB" TextColor="White" FontSize="11" Padding="9,5"/>
                                        </VerticalStackLayout>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                        <Border BackgroundColor="{AppThemeBinding Light=White, Dark=#111C35}" Stroke="{AppThemeBinding Light=#DCE5F5, Dark=#34464B}" StrokeThickness="1" StrokeShape="RoundRectangle 13" Padding="13">
                            <VerticalStackLayout Spacing="9">
                                <Label Text="Current Bill" FontSize="18" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#172554, Dark=#EAF0FF}"/>
                                <CollectionView ItemsSource="{Binding PosCart}" SelectionMode="None" HeightRequest="180">
                                    <CollectionView.ItemTemplate>
                                        <DataTemplate>
                                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="7" Padding="3">
                                                <VerticalStackLayout Spacing="1">
                                                    <Label Text="{Binding ProductName}" FontSize="12" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#1E293B, Dark=#EAF0FF}"/>
                                                    <Label Text="{Binding UnitPrice, StringFormat='₹{0:N2} each'}" FontSize="10" TextColor="{AppThemeBinding Light=#718078, Dark=#A9B9D5}"/>
                                                </VerticalStackLayout>
                                                <Label Grid.Column="1" Text="{Binding Quantity, StringFormat='× {0}'}" FontSize="12" VerticalOptions="Center" TextColor="{AppThemeBinding Light=#1E293B, Dark=#EAF0FF}"/>
                                                <Grid Grid.Column="2" ColumnDefinitions="Auto,Auto">
                                                    <Label Text="{Binding LineTotalText}" FontSize="12" FontAttributes="Bold" VerticalOptions="Center" TextColor="{AppThemeBinding Light=#2563EB, Dark=#93C5FD}"/>
                                                    <Button Grid.Column="1" Text="×" Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.RemovePosCartLineCommand}" CommandParameter="{Binding .}" FontSize="12" Padding="7,2" BackgroundColor="#FEE2E2" TextColor="#B91C1C"/>
                                                </Grid>
                                            </Grid>
                                        </DataTemplate>
                                    </CollectionView.ItemTemplate>
                                </CollectionView>
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Text="Subtotal" FontSize="13" TextColor="{AppThemeBinding Light=#334155, Dark=#CBD5E1}"/>
                                    <Label Grid.Column="1" Text="{Binding PosSubtotalText}" FontSize="13" TextColor="{AppThemeBinding Light=#172554, Dark=#EAF0FF}"/>
                                </Grid>
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <VerticalStackLayout Spacing="3">
                                        <Label Text="Discount %" FontSize="11" TextColor="{AppThemeBinding Light=#718078, Dark=#A9B9D5}"/>
                                        <Entry x:Name="PosDiscountEntry" Text="0" Keyboard="Numeric" TextChanged="PosTotalsChanged" Placeholder="0"/>
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Column="1" Spacing="3">
                                        <Label Text="Tax / GST %" FontSize="11" TextColor="{AppThemeBinding Light=#718078, Dark=#A9B9D5}"/>
                                        <Entry x:Name="PosTaxEntry" Text="5" Keyboard="Numeric" TextChanged="PosTotalsChanged" Placeholder="5"/>
                                    </VerticalStackLayout>
                                </Grid>
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Text="Discount amount" FontSize="12" TextColor="{AppThemeBinding Light=#1E3A8A, Dark=#B9C5BF}"/>
                                    <Label Grid.Column="1" x:Name="PosDiscountAmountLabel" Text="− ₹0.00" FontSize="12" TextColor="{AppThemeBinding Light=#1E3A8A, Dark=#B9C5BF}"/>
                                </Grid>
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Text="Tax amount" FontSize="12" TextColor="{AppThemeBinding Light=#1E3A8A, Dark=#B9C5BF}"/>
                                    <Label Grid.Column="1" x:Name="PosTaxAmountLabel" Text="+ ₹0.00" FontSize="12" TextColor="{AppThemeBinding Light=#1E3A8A, Dark=#B9C5BF}"/>
                                </Grid>
                                <BoxView HeightRequest="1" Color="{AppThemeBinding Light=#DCE5F5, Dark=#34464B}"/>
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Text="AMOUNT PAYABLE" FontSize="13" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#172554, Dark=#EAF0FF}"/>
                                    <Label Grid.Column="1" x:Name="PosGrandTotalLabel" Text="₹0.00" FontSize="22" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#2563EB, Dark=#93C5FD}"/>
                                </Grid>
                                <Label Text="Checkout Details" FontSize="16" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#172554, Dark=#EAF0FF}"/>
                                <Entry x:Name="PosCustomerEntry" Placeholder="Customer name" Text="Walk-in Guest"/>
                                <Entry x:Name="PosTableEntry" Placeholder="Table / order type" Text="Takeaway"/>
                                <Picker x:Name="PosPaymentPicker" Title="Payment method" SelectedIndex="0">
                                    <Picker.Items><x:String>Cash</x:String><x:String>UPI</x:String><x:String>Card</x:String><x:String>Other</x:String></Picker.Items>
                                </Picker>
                                <Entry x:Name="PosCashReceivedEntry" Placeholder="Cash received (₹)" Keyboard="Numeric" TextChanged="PosTotalsChanged"/>
                                <Button Text="Complete Payment &amp; Create Invoice" Clicked="PosCheckoutClicked" BackgroundColor="#2563EB" TextColor="White" FontAttributes="Bold" HeightRequest="48"/>
                                <Label Text="Razorpay API foundation is added. Online checkout remains disabled until the API URL is configured and the app is connected." FontSize="10" TextColor="{AppThemeBinding Light=#8A5A12, Dark=#F5C46B}"/>
                            </VerticalStackLayout>
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout IsVisible="{Binding IsSelfServiceSection}" Spacing="14">
                        <VerticalStackLayout Spacing="3">
                            <Label Text="Self Service Ordering" FontSize="25" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#0F1F45, Dark=#EAF0FF}" />
                            <Label Text="Customer menu • Add items to cart • Place an order" FontSize="13" TextColor="{AppThemeBinding Light=#718078, Dark=#A9B9D5}" />
                        </VerticalStackLayout>
                        <Border BackgroundColor="{AppThemeBinding Light=#EAF0FF, Dark=#1A2B4A}" StrokeThickness="0" StrokeShape="RoundRectangle 12" Padding="13">
                            <Label Text="Choose menu items below. Orders placed here are sent to the kitchen ticket queue." FontSize="13" TextColor="{AppThemeBinding Light=#2563EB, Dark=#93C5FD}" />
                        </Border>
                        <Label Text="Popular Menu" FontSize="18" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#172554, Dark=#EAF0FF}" />
                        <CollectionView ItemsSource="{Binding SelfServiceProducts}" SelectionMode="None">
                            <CollectionView.ItemsLayout><GridItemsLayout Orientation="Vertical" Span="2" HorizontalItemSpacing="9" VerticalItemSpacing="9" /></CollectionView.ItemsLayout>
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Border BackgroundColor="{AppThemeBinding Light=White, Dark=#111C35}" Stroke="{AppThemeBinding Light=#DCE5F5, Dark=#34464B}" StrokeThickness="1" StrokeShape="RoundRectangle 12" Padding="11">
                                        <VerticalStackLayout Spacing="5">
                                            <Label Text="{Binding Category}" FontSize="10" TextColor="#1D4ED8" />
                                            <Label Text="{Binding Name}" FontSize="14" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#172554, Dark=#EAF0FF}" />
                                            <Label Text="{Binding Description}" FontSize="11" TextColor="{AppThemeBinding Light=#718078, Dark=#A9B9D5}" />
                                            <Grid ColumnDefinitions="*,Auto">
                                                <Label Text="{Binding PriceText}" FontSize="14" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#2563EB, Dark=#93C5FD}" VerticalOptions="Center" />
                                                <Button Grid.Column="1" Text="Add +" Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.AddToCartCommand}" CommandParameter="{Binding Name}" BackgroundColor="#2563EB" TextColor="White" FontSize="11" Padding="10,5" />
                                            </Grid>
                                        </VerticalStackLayout>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                        <Border BackgroundColor="{AppThemeBinding Light=White, Dark=#111C35}" Stroke="{AppThemeBinding Light=#DCE5F5, Dark=#34464B}" StrokeThickness="1" StrokeShape="RoundRectangle 13" Padding="13">
                            <VerticalStackLayout Spacing="9">
                                <Label Text="Your Cart" FontSize="18" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#172554, Dark=#EAF0FF}" />
                                <CollectionView ItemsSource="{Binding SelfServiceCart}" SelectionMode="None" HeightRequest="150">
                                    <CollectionView.ItemTemplate>
                                        <DataTemplate>
                                            <Grid ColumnDefinitions="*,Auto,Auto" Padding="3" ColumnSpacing="8">
                                                <Label Text="{Binding ProductName}" FontSize="12" TextColor="{AppThemeBinding Light=#1E293B, Dark=#EAF0FF}" VerticalOptions="Center" />
                                                <Label Grid.Column="1" Text="{Binding LineTotalText}" FontSize="12" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#2563EB, Dark=#93C5FD}" VerticalOptions="Center" />
