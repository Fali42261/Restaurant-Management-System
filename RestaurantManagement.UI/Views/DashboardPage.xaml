<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="RestaurantManagement.UI.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Dashboard"
    BackgroundColor="{AppThemeBinding Light=#F3F5F4, Dark=#10191D}">

    <ContentPage.Resources>
        <ResourceDictionary>
            <Style x:Key="DashboardCardStyle" TargetType="Border">
                <Setter Property="BackgroundColor" Value="White" />
                <Setter Property="Stroke" Value="#E7EBE8" />
                <Setter Property="StrokeThickness" Value="1" />
                <Setter Property="StrokeShape">
                    <Setter.Value>
                        <RoundRectangle CornerRadius="13" />
                    </Setter.Value>
                </Setter>
                <Setter Property="Padding" Value="13" />
            </Style>
            <Style x:Key="NavButtonStyle" TargetType="Button">
                <Setter Property="BackgroundColor" Value="#173C43" />
                <Setter Property="TextColor" Value="#DCE9E8" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="HeightRequest" Value="48" />
                <Setter Property="HorizontalOptions" Value="Fill" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Padding" Value="12,8" />
                <Setter Property="VisualStateManager.VisualStateGroups">
                    <VisualStateGroupList><VisualStateGroup x:Name="CommonStates"><VisualState x:Name="Normal" /><VisualState x:Name="PointerOver"><VisualState.Setters><Setter Property="BackgroundColor" Value="#24616A" /><Setter Property="TextColor" Value="White" /></VisualState.Setters></VisualState></VisualStateGroup></VisualStateGroupList>
                </Setter>
            </Style>
            <Style x:Key="NavChipStyle" TargetType="Button">
                <Setter Property="BackgroundColor" Value="White" />
                <Setter Property="TextColor" Value="#075B63" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Padding" Value="12,8" />
            </Style>
            <Style x:Key="TinyPeriodButtonStyle" TargetType="Button">
                <Setter Property="BackgroundColor" Value="#F4F6F4" />
                <Setter Property="TextColor" Value="#66736B" />
                <Setter Property="CornerRadius" Value="5" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Padding" Value="8,5" />
                <Setter Property="HeightRequest" Value="24" />
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid x:Name="RootLayout" ColumnDefinitions="190,*" RowDefinitions="*">
        <!-- Desktop navigation -->
        <Grid x:Name="Sidebar" Grid.Column="0" RowDefinitions="Auto,*" BackgroundColor="#102F36" Padding="10,16,16,10">
            <VerticalStackLayout Spacing="3" Padding="8,4,4,18">
                <Label Text="swapDigit" FontSize="23" FontAttributes="Bold" TextColor="White" />
                <Label Text="RESTAURANT MANAGEMENT" FontSize="9" CharacterSpacing="1" TextColor="#A9C9C8" />
                <Label x:Name="SidebarRestaurantName" Text="My Restaurant" FontSize="12" FontAttributes="Bold" TextColor="#FFFFFF" Margin="0,5,0,0" />
            </VerticalStackLayout>
            <ScrollView Grid.Row="1" VerticalScrollBarVisibility="Never" Margin="0,0,0,0">
                <VerticalStackLayout Spacing="6">
                    <Button Text="▦  Tables Dashboard" Command="{Binding NavigateCommand}" CommandParameter="Tables" Style="{StaticResource NavButtonStyle}" />
                    <Button Text="▥  Business Dashboard" Command="{Binding NavigateCommand}" CommandParameter="Dashboard" Style="{StaticResource NavButtonStyle}" />
                    <Button Text="☷  POS Billing (F3)" Command="{Binding NavigateCommand}" CommandParameter="POS Billing" Style="{StaticResource NavButtonStyle}" />
                    <Button Text="★  Self Service (F4)" Command="{Binding NavigateCommand}" CommandParameter="Self Service" Style="{StaticResource NavButtonStyle}" />
                    <Button Text="♨  KOT (Kitchen)" Command="{Binding NavigateCommand}" CommandParameter="KOT" Style="{StaticResource NavButtonStyle}" />
                    <Button Text="◷  Reservations" Command="{Binding NavigateCommand}" CommandParameter="Reservations" Style="{StaticResource NavButtonStyle}" />
                    <Button Text="₹  Sales / Bills" Command="{Binding NavigateCommand}" CommandParameter="Sales / Bills" Style="{StaticResource NavButtonStyle}" />
                    <Button Text="▣  Store / Godown" Command="{Binding NavigateCommand}" CommandParameter="Store / Godown" Style="{StaticResource NavButtonStyle}" />
                    <Button Text="▤  Reports" Command="{Binding NavigateCommand}" CommandParameter="Reports" Style="{StaticResource NavButtonStyle}" />
                    <Button Text="▦  Floors &amp; Tables" Command="{Binding NavigateCommand}" CommandParameter="Floors &amp; Tables" Style="{StaticResource NavButtonStyle}" />
                    <Button Text="☷  Orders" Command="{Binding NavigateCommand}" CommandParameter="Orders" Style="{StaticResource NavButtonStyle}" />
                </VerticalStackLayout>
            </ScrollView>
        </Grid>
        <!-- Main content -->
        <Grid Grid.Column="1" RowDefinitions="58,52,*" RowSpacing="0">
            <Grid Grid.Row="0" BackgroundColor="{AppThemeBinding Light=White, Dark=#1B292E}" Padding="12,6"
                  ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8">
                <Label x:Name="WelcomeLabel" Text="Welcome back, Here's what's happening today."
                       FontSize="15" TextColor="#7A8580" VerticalTextAlignment="Center" />
                <Label x:Name="RestaurantSingleName" Grid.Column="2" Text="Restaurant" FontSize="13" FontAttributes="Bold" TextColor="#075B63" VerticalTextAlignment="Center" IsVisible="False" />
                <Picker x:Name="RestaurantPicker" Grid.Column="2" Title="Select restaurant" WidthRequest="190" FontSize="13" TextColor="#075B63" VerticalOptions="Center" IsVisible="False" SelectedIndexChanged="RestaurantPickerChanged" />
                <Button x:Name="NotificationButton" Grid.Column="1" Text="🔔" Clicked="ToggleNotificationPopup"
                        BackgroundColor="Transparent" TextColor="#53635A" FontSize="19"
                        Padding="7,0" VerticalOptions="Center" />
                <Border x:Name="ProfilePanel" Grid.Column="3" StrokeThickness="0" BackgroundColor="{AppThemeBinding Light=#F1F5F1, Dark=#26383D}" StrokeShape="RoundRectangle 11" Padding="6,4" VerticalOptions="Center">
                    <Border.GestureRecognizers><TapGestureRecognizer Tapped="ToggleUserMenu" /></Border.GestureRecognizers>
                    <HorizontalStackLayout Spacing="7" VerticalOptions="Center">
                        <Border BackgroundColor="#DDEBD6" StrokeThickness="0" StrokeShape="RoundRectangle 16" WidthRequest="32" HeightRequest="32">
                            <Label Text="👤" FontSize="17" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                        </Border>
                        <VerticalStackLayout Spacing="0"><Label x:Name="ProfileName" Text="User" FontSize="13" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#34433A, Dark=#E7EFEB}" /><Label x:Name="ProfileRole" Text="Owner" FontSize="10" TextColor="{AppThemeBinding Light=#718078, Dark=#AAB8B0}" /></VerticalStackLayout>
                        <Label Text="⌄" FontSize="15" TextColor="#65716A" VerticalTextAlignment="Center" />
                    </HorizontalStackLayout>
                </Border>
            </Grid>

            <ScrollView x:Name="MobileNavigation" Grid.Row="1" IsVisible="False" Orientation="Horizontal" HorizontalScrollBarVisibility="Never" BackgroundColor="#102F36">
                <HorizontalStackLayout Spacing="6" Padding="10,4">
                    <Button Text="Tables Dashboard" Command="{Binding NavigateCommand}" CommandParameter="Tables" Style="{StaticResource NavChipStyle}" />
                    <Button Text="Business Dashboard" Command="{Binding NavigateCommand}" CommandParameter="Dashboard" Style="{StaticResource NavChipStyle}" />
                    <Button Text="POS Billing (F3)" Command="{Binding NavigateCommand}" CommandParameter="POS Billing" Style="{StaticResource NavChipStyle}" />
                    <Button Text="Self Service (F4)" Command="{Binding NavigateCommand}" CommandParameter="Self Service" Style="{StaticResource NavChipStyle}" />
                    <Button Text="KOT (Kitchen)" Command="{Binding NavigateCommand}" CommandParameter="KOT" Style="{StaticResource NavChipStyle}" />
                    <Button Text="Reservations" Command="{Binding NavigateCommand}" CommandParameter="Reservations" Style="{StaticResource NavChipStyle}" />
                    <Button Text="Sales / Bills" Command="{Binding NavigateCommand}" CommandParameter="Sales / Bills" Style="{StaticResource NavChipStyle}" />
                    <Button Text="Store / Godown" Command="{Binding NavigateCommand}" CommandParameter="Store / Godown" Style="{StaticResource NavChipStyle}" />
                    <Button Text="Reports" Command="{Binding NavigateCommand}" CommandParameter="Reports" Style="{StaticResource NavChipStyle}" />
                    <Button Text="Floors &amp; Tables" Command="{Binding NavigateCommand}" CommandParameter="Floors &amp; Tables" Style="{StaticResource NavChipStyle}" />
                    <Button Text="Orders" Command="{Binding NavigateCommand}" CommandParameter="Orders" Style="{StaticResource NavChipStyle}" />
                </HorizontalStackLayout>
            </ScrollView>

            <ScrollView Grid.Row="2">
                <VerticalStackLayout Padding="16" Spacing="13">
                    <Label Text="{Binding SectionTitle}" IsVisible="{Binding IsOtherSection}" FontSize="26" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#222D27, Dark=#E7EFEB}" />
                    <VerticalStackLayout IsVisible="{Binding IsPosBillingSection}" Spacing="14">
                        <VerticalStackLayout Spacing="3">
                            <Label Text="POS Billing" FontSize="25" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#222D27, Dark=#E7EFEB}" />
                            <Label Text="Build an itemised bill, apply discount and tax, collect payment and create an invoice." FontSize="13" TextColor="{AppThemeBinding Light=#718078, Dark=#AAB8B0}" />
                        </VerticalStackLayout>
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <Border BackgroundColor="{AppThemeBinding Light=#EAF4F2, Dark=#203A3E}" StrokeThickness="0" StrokeShape="RoundRectangle 11" Padding="12">
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="CART SUBTOTAL" FontSize="10" TextColor="#08766F"/>
                                    <Label Text="{Binding PosSubtotalText}" FontSize="23" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#075B63, Dark=#75C8C3}"/>
                                </VerticalStackLayout>
                            </Border>
                            <Border Grid.Column="1" BackgroundColor="{AppThemeBinding Light=#F1F5F1, Dark=#26383D}" StrokeThickness="0" StrokeShape="RoundRectangle 11" Padding="12" VerticalOptions="Fill">
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="ITEMS" FontSize="10" TextColor="{AppThemeBinding Light=#718078, Dark=#AAB8B0}"/>
                                    <Label Text="{Binding PosCartCountText}" FontSize="18" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#26332D, Dark=#E7EFEB}"/>
                                </VerticalStackLayout>
                            </Border>
                        </Grid>
                        <Label Text="Menu Items" FontSize="18" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#26332D, Dark=#E7EFEB}"/>
                        <CollectionView ItemsSource="{Binding SelfServiceProducts}" SelectionMode="None">
                            <CollectionView.ItemsLayout><GridItemsLayout Orientation="Vertical" Span="2" HorizontalItemSpacing="9" VerticalItemSpacing="9"/></CollectionView.ItemsLayout>
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Border BackgroundColor="{AppThemeBinding Light=White, Dark=#1B292E}" Stroke="{AppThemeBinding Light=#E1E8E3, Dark=#34464B}" StrokeThickness="1" StrokeShape="RoundRectangle 12" Padding="11">
                                        <VerticalStackLayout Spacing="5">
                                            <Label Text="{Binding Category}" FontSize="10" TextColor="#078078"/>
                                            <Label Text="{Binding Name}" FontSize="14" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#26332D, Dark=#E7EFEB}"/>
                                            <Label Text="{Binding PriceText}" FontSize="14" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#075B63, Dark=#75C8C3}"/>
                                            <Button Text="Add to Bill +" Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.AddPosToCartCommand}" CommandParameter="{Binding Name}" BackgroundColor="#075B63" TextColor="White" FontSize="11" Padding="9,5"/>
                                        </VerticalStackLayout>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                        <Border BackgroundColor="{AppThemeBinding Light=White, Dark=#1B292E}" Stroke="{AppThemeBinding Light=#DDE5DF, Dark=#34464B}" StrokeThickness="1" StrokeShape="RoundRectangle 13" Padding="13">
                            <VerticalStackLayout Spacing="9">
                                <Label Text="Current Bill" FontSize="18" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#26332D, Dark=#E7EFEB}"/>
                                <CollectionView ItemsSource="{Binding PosCart}" SelectionMode="None" HeightRequest="180">
                                    <CollectionView.ItemTemplate>
                                        <DataTemplate>
                                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="7" Padding="3">
                                                <VerticalStackLayout Spacing="1">
                                                    <Label Text="{Binding ProductName}" FontSize="12" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#34433A, Dark=#E7EFEB}"/>
                                                    <Label Text="{Binding UnitPrice, StringFormat='₹{0:N2} each'}" FontSize="10" TextColor="{AppThemeBinding Light=#718078, Dark=#AAB8B0}"/>
                                                </VerticalStackLayout>
                                                <Label Grid.Column="1" Text="{Binding Quantity, StringFormat='× {0}'}" FontSize="12" VerticalOptions="Center" TextColor="{AppThemeBinding Light=#34433A, Dark=#E7EFEB}"/>
                                                <Grid Grid.Column="2" ColumnDefinitions="Auto,Auto">
                                                    <Label Text="{Binding LineTotalText}" FontSize="12" FontAttributes="Bold" VerticalOptions="Center" TextColor="{AppThemeBinding Light=#075B63, Dark=#75C8C3}"/>
                                                    <Button Grid.Column="1" Text="×" Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.RemovePosCartLineCommand}" CommandParameter="{Binding .}" FontSize="12" Padding="7,2" BackgroundColor="#FCE9E7" TextColor="#A33B32"/>
                                                </Grid>
                                            </Grid>
                                        </DataTemplate>
                                    </CollectionView.ItemTemplate>
                                </CollectionView>
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Text="Subtotal" FontSize="13" TextColor="{AppThemeBinding Light=#536159, Dark=#B9C5BF}"/>
                                    <Label Grid.Column="1" Text="{Binding PosSubtotalText}" FontSize="13" TextColor="{AppThemeBinding Light=#26332D, Dark=#E7EFEB}"/>
                                </Grid>
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <VerticalStackLayout Spacing="3">
                                        <Label Text="Discount %" FontSize="11" TextColor="{AppThemeBinding Light=#718078, Dark=#AAB8B0}"/>
                                        <Entry x:Name="PosDiscountEntry" Text="0" Keyboard="Numeric" TextChanged="PosTotalsChanged" Placeholder="0"/>
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Column="1" Spacing="3">
                                        <Label Text="Tax / GST %" FontSize="11" TextColor="{AppThemeBinding Light=#718078, Dark=#AAB8B0}"/>
                                        <Entry x:Name="PosTaxEntry" Text="5" Keyboard="Numeric" TextChanged="PosTotalsChanged" Placeholder="5"/>
                                    </VerticalStackLayout>
                                </Grid>
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Text="Discount amount" FontSize="12" TextColor="{AppThemeBinding Light=#536159, Dark=#B9C5BF}"/>
                                    <Label Grid.Column="1" x:Name="PosDiscountAmountLabel" Text="− ₹0.00" FontSize="12" TextColor="{AppThemeBinding Light=#536159, Dark=#B9C5BF}"/>
                                </Grid>
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Text="Tax amount" FontSize="12" TextColor="{AppThemeBinding Light=#536159, Dark=#B9C5BF}"/>
                                    <Label Grid.Column="1" x:Name="PosTaxAmountLabel" Text="+ ₹0.00" FontSize="12" TextColor="{AppThemeBinding Light=#536159, Dark=#B9C5BF}"/>
                                </Grid>
                                <BoxView HeightRequest="1" Color="{AppThemeBinding Light=#DDE5DF, Dark=#34464B}"/>
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Text="AMOUNT PAYABLE" FontSize="13" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#26332D, Dark=#E7EFEB}"/>
                                    <Label Grid.Column="1" x:Name="PosGrandTotalLabel" Text="₹0.00" FontSize="22" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#075B63, Dark=#75C8C3}"/>
                                </Grid>
                                <Label Text="Checkout Details" FontSize="16" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#26332D, Dark=#E7EFEB}"/>
                                <Entry x:Name="PosCustomerEntry" Placeholder="Customer name" Text="Walk-in Guest"/>
                                <Entry x:Name="PosTableEntry" Placeholder="Table / order type" Text="Takeaway"/>
                                <Picker x:Name="PosPaymentPicker" Title="Payment method" SelectedIndex="0">
                                    <Picker.Items><x:String>Cash</x:String><x:String>UPI</x:String><x:String>Card</x:String><x:String>Other</x:String></Picker.Items>
                                </Picker>
                                <Entry x:Name="PosCashReceivedEntry" Placeholder="Cash received (₹)" Keyboard="Numeric" TextChanged="PosTotalsChanged"/>
                                <Button Text="Complete Payment &amp; Create Invoice" Clicked="PosCheckoutClicked" BackgroundColor="#075B63" TextColor="White" FontAttributes="Bold" HeightRequest="48"/>
                                <Label Text="Razorpay API foundation is added. Online checkout remains disabled until the API URL is configured and the app is connected." FontSize="10" TextColor="{AppThemeBinding Light=#8A5A12, Dark=#F5C46B}"/>
                            </VerticalStackLayout>
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout IsVisible="{Binding IsSelfServiceSection}" Spacing="14">
                        <VerticalStackLayout Spacing="3">
                            <Label Text="Self Service Ordering" FontSize="25" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#222D27, Dark=#E7EFEB}" />
                            <Label Text="Customer menu • Add items to cart • Place an order" FontSize="13" TextColor="{AppThemeBinding Light=#718078, Dark=#AAB8B0}" />
                        </VerticalStackLayout>
                        <Border BackgroundColor="{AppThemeBinding Light=#EAF4F2, Dark=#203A3E}" StrokeThickness="0" StrokeShape="RoundRectangle 12" Padding="13">
                            <Label Text="Choose menu items below. Orders placed here are sent to the kitchen ticket queue." FontSize="13" TextColor="{AppThemeBinding Light=#075B63, Dark=#75C8C3}" />
                        </Border>
                        <Label Text="Popular Menu" FontSize="18" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#26332D, Dark=#E7EFEB}" />
                        <CollectionView ItemsSource="{Binding SelfServiceProducts}" SelectionMode="None">
                            <CollectionView.ItemsLayout><GridItemsLayout Orientation="Vertical" Span="2" HorizontalItemSpacing="9" VerticalItemSpacing="9" /></CollectionView.ItemsLayout>
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Border BackgroundColor="{AppThemeBinding Light=White, Dark=#1B292E}" Stroke="{AppThemeBinding Light=#E1E8E3, Dark=#34464B}" StrokeThickness="1" StrokeShape="RoundRectangle 12" Padding="11">
                                        <VerticalStackLayout Spacing="5">
                                            <Label Text="{Binding Category}" FontSize="10" TextColor="#078078" />
                                            <Label Text="{Binding Name}" FontSize="14" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#26332D, Dark=#E7EFEB}" />
                                            <Label Text="{Binding Description}" FontSize="11" TextColor="{AppThemeBinding Light=#718078, Dark=#AAB8B0}" />
                                            <Grid ColumnDefinitions="*,Auto">
                                                <Label Text="{Binding PriceText}" FontSize="14" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#075B63, Dark=#75C8C3}" VerticalOptions="Center" />
                                                <Button Grid.Column="1" Text="Add +" Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.AddToCartCommand}" CommandParameter="{Binding Name}" BackgroundColor="#075B63" TextColor="White" FontSize="11" Padding="10,5" />
                                            </Grid>
                                        </VerticalStackLayout>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                        <Border BackgroundColor="{AppThemeBinding Light=White, Dark=#1B292E}" Stroke="{AppThemeBinding Light=#DDE5DF, Dark=#34464B}" StrokeThickness="1" StrokeShape="RoundRectangle 13" Padding="13">
                            <VerticalStackLayout Spacing="9">
                                <Label Text="Your Cart" FontSize="18" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#26332D, Dark=#E7EFEB}" />
                                <CollectionView ItemsSource="{Binding SelfServiceCart}" SelectionMode="None" HeightRequest="150">
                                    <CollectionView.ItemTemplate>
                                        <DataTemplate>
                                            <Grid ColumnDefinitions="*,Auto,Auto" Padding="3" ColumnSpacing="8">
                                                <Label Text="{Binding ProductName}" FontSize="12" TextColor="{AppThemeBinding Light=#34433A, Dark=#E7EFEB}" VerticalOptions="Center" />
                                                <Label Grid.Column="1" Text="{Binding LineTotalText}" FontSize="12" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#075B63, Dark=#75C8C3}" VerticalOptions="Center" />
                                                <Button Grid.Column="2" Text="Remove" Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.RemoveCartLineCommand}" CommandParameter="{Binding .}" FontSize="10" Padding="7,3" BackgroundColor="#FCE9E7" TextColor="#A33B32" />
                                            </Grid>
                                        </DataTemplate>
                                    </CollectionView.ItemTemplate>
                                </CollectionView>
                                <Label Text="{Binding CartTotalText}" FontSize="16" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#075B63, Dark=#75C8C3}" HorizontalOptions="End" />
                                <Button Text="Place Order • Send to Kitchen" Command="{Binding PlaceSelfServiceOrderCommand}" BackgroundColor="#075B63" TextColor="White" FontAttributes="Bold" HeightRequest="46" />
                            </VerticalStackLayout>
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout IsVisible="{Binding IsKotSection}" Spacing="14">
                        <VerticalStackLayout Spacing="3">
                            <Label Text="Kitchen Order Tickets" FontSize="25" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#222D27, Dark=#E7EFEB}" />
                            <Label Text="Track incoming orders and move each ticket through kitchen preparation." FontSize="13" TextColor="{AppThemeBinding Light=#718078, Dark=#AAB8B0}" />
                            <Label Text="{Binding KitchenDataStatus}" FontSize="11" TextColor="{AppThemeBinding Light=#718078, Dark=#AAB8B0}" />
                        </VerticalStackLayout>
                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                            <Border BackgroundColor="{AppThemeBinding Light=#FFF5E5, Dark=#3A3020}" StrokeThickness="0" StrokeShape="RoundRectangle 10" Padding="10"><VerticalStackLayout><Label Text="NEW" FontSize="10" TextColor="#A56A12"/><Label Text="{Binding NewKotCount}" FontSize="22" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#8A5A12, Dark=#F5C46B}"/></VerticalStackLayout></Border>
                            <Border Grid.Column="1" BackgroundColor="{AppThemeBinding Light=#EAF2FC, Dark=#202F43}" StrokeThickness="0" StrokeShape="RoundRectangle 10" Padding="10"><VerticalStackLayout><Label Text="PREPARING" FontSize="10" TextColor="#2563A6"/><Label Text="{Binding PreparingKotCount}" FontSize="22" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#2563A6, Dark=#8AB8F0}"/></VerticalStackLayout></Border>
                            <Border Grid.Column="2" BackgroundColor="{AppThemeBinding Light=#E8F5EC, Dark=#20382A}" StrokeThickness="0" StrokeShape="RoundRectangle 10" Padding="10"><VerticalStackLayout><Label Text="READY" FontSize="10" TextColor="#17804A"/><Label Text="{Binding ReadyKotCount}" FontSize="22" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#17804A, Dark=#8AD5A7}"/></VerticalStackLayout></Border>
                        </Grid>
                        <CollectionView ItemsSource="{Binding KitchenTickets}" SelectionMode="None">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Border BackgroundColor="{AppThemeBinding Light=White, Dark=#1B292E}" Stroke="{AppThemeBinding Light=#E1E8E3, Dark=#34464B}" StrokeThickness="1" StrokeShape="RoundRectangle 13" Padding="14" Margin="0,0,0,10">
                                        <VerticalStackLayout Spacing="8">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <Label Text="{Binding TicketNumber}" FontSize="16" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#26332D, Dark=#E7EFEB}" />
                                                <Label Grid.Column="1" Text="{Binding Status}" FontSize="12" FontAttributes="Bold" TextColor="{Binding StatusColor}" VerticalOptions="Center" />
                                            </Grid>
                                            <Grid ColumnDefinitions="*,Auto">
                                                <Label Text="{Binding OrderType}" FontSize="12" TextColor="{AppThemeBinding Light=#075B63, Dark=#75C8C3}" />
                                                <Label Grid.Column="1" Text="{Binding AgeText}" FontSize="11" TextColor="{AppThemeBinding Light=#718078, Dark=#AAB8B0}" />
                                            </Grid>
                                            <Label Text="{Binding Items}" FontSize="13" TextColor="{AppThemeBinding Light=#536159, Dark=#B9C5BF}" />
                                            <Button Text="{Binding ActionText}" Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.AdvanceKotCommand}" CommandParameter="{Binding .}" BackgroundColor="#075B63" TextColor="White" FontSize="12" />
                                        </VerticalStackLayout>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>

                    <VerticalStackLayout IsVisible="{Binding IsReservationsSection}" Spacing="14">
                        <VerticalStackLayout Spacing="3">
                            <Label Text="Reservations" FontSize="25" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#222D27, Dark=#E7EFEB}" />
                            <Label Text="Create guest bookings and manage confirmation status." FontSize="13" TextColor="{AppThemeBinding Light=#718078, Dark=#AAB8B0}" />
                        </VerticalStackLayout>
                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                            <Border BackgroundColor="{AppThemeBinding Light=#EAF4F2, Dark=#203A3E}" StrokeThickness="0" StrokeShape="RoundRectangle 10" Padding="10">
                                <VerticalStackLayout><Label Text="TODAY" FontSize="10" TextColor="#08766F"/><Label Text="{Binding TodayReservationCount}" FontSize="22" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#075B63, Dark=#75C8C3}"/></VerticalStackLayout>
                            </Border>
                            <Border Grid.Column="1" BackgroundColor="{AppThemeBinding Light=#FFF5E5, Dark=#3A3020}" StrokeThickness="0" StrokeShape="RoundRectangle 10" Padding="10">
                                <VerticalStackLayout><Label Text="PENDING" FontSize="10" TextColor="#A56A12"/><Label Text="{Binding PendingReservationCount}" FontSize="22" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#8A5A12, Dark=#F5C46B}"/></VerticalStackLayout>
                            </Border>
                            <Border Grid.Column="2" BackgroundColor="{AppThemeBinding Light=#E8F5EC, Dark=#20382A}" StrokeThickness="0" StrokeShape="RoundRectangle 10" Padding="10">
                                <VerticalStackLayout><Label Text="CONFIRMED" FontSize="10" TextColor="#17804A"/><Label Text="{Binding ConfirmedReservationCount}" FontSize="22" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#17804A, Dark=#8AD5A7}"/></VerticalStackLayout>
                            </Border>
                        </Grid>
                        <Border BackgroundColor="{AppThemeBinding Light=White, Dark=#1B292E}" Stroke="{AppThemeBinding Light=#DDE5DF, Dark=#34464B}" StrokeThickness="1" StrokeShape="RoundRectangle 13" Padding="14">
                            <VerticalStackLayout Spacing="9">
                                <Label Text="New Reservation" FontSize="18" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#26332D, Dark=#E7EFEB}"/>
                                <Entry x:Name="ReservationGuestEntry" Placeholder="Guest name" />
