                                       TextColor="{AppThemeBinding Light=#718078, Dark=#A9B9D5}" />
                            </VerticalStackLayout>
                        </Border>
                    </Grid>

                    <!-- Live popular products; reservations and recent-order previews are intentionally excluded from Dashboard. -->
                    <Grid x:Name="BottomGrid" IsVisible="{Binding IsDashboardSection}" ColumnDefinitions="*" RowDefinitions="Auto">
                        <Border Style="{StaticResource DashboardCardStyle}">
                            <VerticalStackLayout Spacing="12">
                                <Label Text="POPULAR ITEMS" FontSize="16" CharacterSpacing="0.7"
                                       TextColor="{AppThemeBinding Light=#1E3A8A, Dark=#B9C5BF}" FontAttributes="Bold" />
                                <CollectionView ItemsSource="{Binding DashboardTopProducts}" SelectionMode="None">
                                    <CollectionView.EmptyView>
                                        <Label Text="No product sales found for the last 7 days." FontSize="12"
                                               TextColor="{AppThemeBinding Light=#718078, Dark=#A9B9D5}" />
                                    </CollectionView.EmptyView>
                                    <CollectionView.ItemTemplate>
                                        <DataTemplate>
                                            <Grid ColumnDefinitions="*,Auto" Padding="0,7">
                                                <VerticalStackLayout Spacing="2">
                                                    <Label Text="{Binding Name}" FontSize="13" FontAttributes="Bold"
                                                           TextColor="{AppThemeBinding Light=#172554, Dark=#EAF0FF}" />
                                                    <Label Text="{Binding QuantitySold, StringFormat='{0} sold'}" FontSize="11"
                                                           TextColor="{AppThemeBinding Light=#9AA39E, Dark=#A9B9D5}" />
                                                </VerticalStackLayout>
                                                <Label Grid.Column="1" Text="{Binding Sales, StringFormat='₹{0:N0}'}"
                                                       FontSize="13" FontAttributes="Bold"
                                                       TextColor="{AppThemeBinding Light=#2563EB, Dark=#93C5FD}"
                                                       VerticalOptions="Center" />
                                            </Grid>
                                        </DataTemplate>
                                    </CollectionView.ItemTemplate>
                                </CollectionView>
                            </VerticalStackLayout>
                        </Border>
                    </Grid>

                </VerticalStackLayout>
            </ScrollView>
        </Grid>
    <Border x:Name="UserMenu" Grid.Column="1" IsVisible="False" BackgroundColor="{AppThemeBinding Light=White, Dark=#111C35}" Stroke="{AppThemeBinding Light=#DCE5F5, Dark=#34464B}" StrokeThickness="1" StrokeShape="RoundRectangle 14" Padding="8" WidthRequest="230" HorizontalOptions="End" VerticalOptions="Start" Margin="0,62,8,0" ZIndex="100">
        <VerticalStackLayout Spacing="3">
            <Border BackgroundColor="Transparent" StrokeThickness="0" StrokeShape="RoundRectangle 8" Padding="10,9">
                <Border.GestureRecognizers><TapGestureRecognizer Tapped="SubscriptionMenuTapped" /></Border.GestureRecognizers>
                <Grid ColumnDefinitions="26,*" ColumnSpacing="8">
                    <Label Text="💳" FontSize="15" TextColor="{AppThemeBinding Light=#1E293B, Dark=#EAF0FF}" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                    <Label Grid.Column="1" Text="Subscription Plans" FontSize="13" TextColor="{AppThemeBinding Light=#1E293B, Dark=#EAF0FF}" VerticalTextAlignment="Center" />
                </Grid>
            </Border>
            <Border BackgroundColor="Transparent" StrokeThickness="0" StrokeShape="RoundRectangle 8" Padding="10,9">
                <Border.GestureRecognizers><TapGestureRecognizer Tapped="SettingsMenuTapped" /></Border.GestureRecognizers>
                <Grid ColumnDefinitions="26,*" ColumnSpacing="8">
                    <Label Text="⚙" FontSize="15" TextColor="{AppThemeBinding Light=#1E293B, Dark=#EAF0FF}" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                    <Label Grid.Column="1" Text="Settings" FontSize="13" TextColor="{AppThemeBinding Light=#1E293B, Dark=#EAF0FF}" VerticalTextAlignment="Center" />
                </Grid>
            </Border>
            <BoxView HeightRequest="1" BackgroundColor="{AppThemeBinding Light=#DCE5F5, Dark=#34464B}" Margin="6,3" />
            <Border BackgroundColor="Transparent" StrokeThickness="0" StrokeShape="RoundRectangle 8" Padding="10,9">
                <Border.GestureRecognizers><TapGestureRecognizer Tapped="LogoutMenuTapped" /></Border.GestureRecognizers>
                <Grid ColumnDefinitions="26,*" ColumnSpacing="8">
                    <Label Text="↪" FontSize="15" TextColor="{AppThemeBinding Light=#B94B45, Dark=#FCA5A5}" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                    <Label Grid.Column="1" Text="Logout" FontSize="13" TextColor="{AppThemeBinding Light=#B94B45, Dark=#FCA5A5}" VerticalTextAlignment="Center" />
                </Grid>
            </Border>
        </VerticalStackLayout>
    </Border>
    <Border x:Name="NotificationPopup" Grid.Column="1" IsVisible="False" BackgroundColor="{AppThemeBinding Light=White, Dark=#111C35}" Stroke="{AppThemeBinding Light=#DCE5F5, Dark=#34464B}" StrokeThickness="1" StrokeShape="RoundRectangle 14" Padding="12" WidthRequest="270" HorizontalOptions="End" VerticalOptions="Start" Margin="0,62,8,0" ZIndex="101">
        <VerticalStackLayout Spacing="8">
            <Grid ColumnDefinitions="*,Auto">
                <Label Text="Notifications" FontSize="16" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#172554, Dark=#EAF0FF}"/>
                <Button Grid.Column="1" Text="✕" Clicked="CloseNotificationPopup" BackgroundColor="{AppThemeBinding Light=#E8EEFF, Dark=#172554}" TextColor="{AppThemeBinding Light=#1E3A8A, Dark=#B9C5BF}" FontSize="13" Padding="7,3"/>
            </Grid>
            <BoxView HeightRequest="1" BackgroundColor="#DCE5F5"/>
            <Label Text="You're all caught up." FontSize="14" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#1E293B, Dark=#EAF0FF}"/>
            <Label Text="New orders, reservations and kitchen alerts will appear here." FontSize="12" TextColor="{AppThemeBinding Light=#718078, Dark=#A9B9D5}"/>
        </VerticalStackLayout>
    </Border>
    <Grid x:Name="ManagementPopup" IsVisible="False" BackgroundColor="#66000000" ZIndex="120" Grid.ColumnSpan="2">
        <Border BackgroundColor="{AppThemeBinding Light=White, Dark=#111C35}" Stroke="{AppThemeBinding Light=#DCE5F5, Dark=#34464B}" StrokeThickness="1" StrokeShape="RoundRectangle 18" Padding="18" WidthRequest="320" MaximumWidthRequest="360" HorizontalOptions="Center" VerticalOptions="Center">
            <VerticalStackLayout Spacing="12">
                <Label x:Name="ManagementPopupTitle" Text="Add Table" FontSize="19" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#2563EB, Dark=#93C5FD}"/>
                <VerticalStackLayout x:Name="FloorFields" Spacing="8">
                    <Label Text="Floor name" FontSize="12" TextColor="{AppThemeBinding Light=#1E3A8A, Dark=#B9C5BF}"/>
                    <Entry x:Name="FloorNameEntry" Placeholder="e.g. First Floor" BackgroundColor="{AppThemeBinding Light=#F4F7FF, Dark=#172554}"/>
                </VerticalStackLayout>
                <VerticalStackLayout x:Name="TableFields" Spacing="8">
                    <Label Text="Table name / number" FontSize="12" TextColor="{AppThemeBinding Light=#1E3A8A, Dark=#B9C5BF}"/>
                    <Entry x:Name="TableNameEntry" Placeholder="e.g. T13" BackgroundColor="{AppThemeBinding Light=#F4F7FF, Dark=#172554}"/>
                    <Label Text="Seats" FontSize="12" TextColor="{AppThemeBinding Light=#1E3A8A, Dark=#B9C5BF}"/>
                    <Entry x:Name="TableSeatsEntry" Placeholder="4" Keyboard="Numeric" BackgroundColor="{AppThemeBinding Light=#F4F7FF, Dark=#172554}"/>
                    <Label Text="Floor" FontSize="12" TextColor="{AppThemeBinding Light=#1E3A8A, Dark=#B9C5BF}"/>
                    <Picker x:Name="TableFloorPicker" Title="Select floor" />
                </VerticalStackLayout>
                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                    <Button Text="Cancel" Clicked="CancelManagementPopup" BackgroundColor="#E8EEFF" TextColor="{AppThemeBinding Light=#1E3A8A, Dark=#B9C5BF}"/>
                    <Button Grid.Column="1" x:Name="ManagementSaveButton" Text="Save" Clicked="SaveManagementPopup" BackgroundColor="#2563EB" TextColor="White"/>
                </Grid>
            </VerticalStackLayout>
        </Border>
    </Grid>
    <Grid x:Name="TrialLockOverlay" Grid.ColumnSpan="2" IsVisible="False" BackgroundColor="#F4F7FF" ZIndex="200" Padding="20">        <Border BackgroundColor="{AppThemeBinding Light=White, Dark=#111C35}" Stroke="{AppThemeBinding Light=#DCE5F5, Dark=#34464B}" StrokeThickness="1" StrokeShape="RoundRectangle 20" Padding="22" MaximumWidthRequest="520" HorizontalOptions="Center" VerticalOptions="Center">
            <VerticalStackLayout Spacing="14">
                <Label Text="swapDigit" FontSize="22" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#2563EB, Dark=#93C5FD}" HorizontalOptions="Center" />
                <Label Text="Your free trial has ended" FontSize="23" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#E8EEFF, Dark=#D9EFEC}" HorizontalTextAlignment="Center" />
                <Label Text="Your 3-day free trial is complete. Choose a subscription plan to continue using restaurant management, billing, orders, tables and all other features." FontSize="14" TextColor="{AppThemeBinding Light=#1E3A8A, Dark=#B9C5BF}" HorizontalTextAlignment="Center" />
                <Label Text="Subscription is required to unlock the app." FontSize="13" FontAttributes="Bold" TextColor="#B94B45" HorizontalTextAlignment="Center" />
                <Button Text="View Subscription Plans" Clicked="OpenSubscriptionFromTrial" BackgroundColor="#2563EB" TextColor="White" FontAttributes="Bold" HeightRequest="48" />
            </VerticalStackLayout>
        </Border>
    </Grid>
    </Grid>


</ContentPage>