            </Grid>
            <BoxView HeightRequest="1" BackgroundColor="#E7EBE8"/>
            <Label Text="You're all caught up." FontSize="14" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#34433A, Dark=#E7EFEB}"/>
            <Label Text="New orders, reservations and kitchen alerts will appear here." FontSize="12" TextColor="{AppThemeBinding Light=#718078, Dark=#AAB8B0}"/>
        </VerticalStackLayout>
    </Border>
    <Grid x:Name="ManagementPopup" IsVisible="False" BackgroundColor="#66000000" ZIndex="120" Grid.ColumnSpan="2">
        <Border BackgroundColor="{AppThemeBinding Light=White, Dark=#1B292E}" Stroke="{AppThemeBinding Light=#DDE5DF, Dark=#34464B}" StrokeThickness="1" StrokeShape="RoundRectangle 18" Padding="18" WidthRequest="320" MaximumWidthRequest="360" HorizontalOptions="Center" VerticalOptions="Center">
            <VerticalStackLayout Spacing="12">
                <Label x:Name="ManagementPopupTitle" Text="Add Table" FontSize="19" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#075B63, Dark=#75C8C3}"/>
                <VerticalStackLayout x:Name="FloorFields" Spacing="8">
                    <Label Text="Floor name" FontSize="12" TextColor="{AppThemeBinding Light=#536159, Dark=#B9C5BF}"/>
                    <Entry x:Name="FloorNameEntry" Placeholder="e.g. First Floor" BackgroundColor="{AppThemeBinding Light=#F5F7F5, Dark=#26383D}"/>
                </VerticalStackLayout>
                <VerticalStackLayout x:Name="TableFields" Spacing="8">
                    <Label Text="Table name / number" FontSize="12" TextColor="{AppThemeBinding Light=#536159, Dark=#B9C5BF}"/>
                    <Entry x:Name="TableNameEntry" Placeholder="e.g. T13" BackgroundColor="{AppThemeBinding Light=#F5F7F5, Dark=#26383D}"/>
                    <Label Text="Seats" FontSize="12" TextColor="{AppThemeBinding Light=#536159, Dark=#B9C5BF}"/>
                    <Entry x:Name="TableSeatsEntry" Placeholder="4" Keyboard="Numeric" BackgroundColor="{AppThemeBinding Light=#F5F7F5, Dark=#26383D}"/>
                    <Label Text="Floor" FontSize="12" TextColor="{AppThemeBinding Light=#536159, Dark=#B9C5BF}"/>
                    <Picker x:Name="TableFloorPicker" Title="Select floor" />
                </VerticalStackLayout>
                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                    <Button Text="Cancel" Clicked="CancelManagementPopup" BackgroundColor="#EEF2EF" TextColor="{AppThemeBinding Light=#536159, Dark=#B9C5BF}"/>
                    <Button Grid.Column="1" x:Name="ManagementSaveButton" Text="Save" Clicked="SaveManagementPopup" BackgroundColor="#075B63" TextColor="White"/>
                </Grid>
            </VerticalStackLayout>
        </Border>
    </Grid>
    <Grid x:Name="TrialLockOverlay" Grid.ColumnSpan="2" IsVisible="False" BackgroundColor="#F2F4F3" ZIndex="200" Padding="20">
        <Border BackgroundColor="{AppThemeBinding Light=White, Dark=#1B292E}" Stroke="{AppThemeBinding Light=#DDE5DF, Dark=#34464B}" StrokeThickness="1" StrokeShape="RoundRectangle 20" Padding="22" MaximumWidthRequest="520" HorizontalOptions="Center" VerticalOptions="Center">
            <VerticalStackLayout Spacing="14">
                <Label Text="swapDigit" FontSize="22" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#075B63, Dark=#75C8C3}" HorizontalOptions="Center" />
                <Label Text="Your free trial has ended" FontSize="23" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#173C43, Dark=#D9EFEC}" HorizontalTextAlignment="Center" />
                <Label Text="Your 3-day free trial is complete. Choose a subscription plan to continue using restaurant management, billing, orders, tables and all other features." FontSize="14" TextColor="{AppThemeBinding Light=#536159, Dark=#B9C5BF}" HorizontalTextAlignment="Center" />
                <Label Text="Subscription is required to unlock the app." FontSize="13" FontAttributes="Bold" TextColor="#B94B45" HorizontalTextAlignment="Center" />
                <Button Text="View Subscription Plans" Clicked="OpenSubscriptionFromTrial" BackgroundColor="#075B63" TextColor="White" FontAttributes="Bold" HeightRequest="48" />
            </VerticalStackLayout>
        </Border>
    </Grid>
    </Grid>


</ContentPage>