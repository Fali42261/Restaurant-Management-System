<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="RestaurantManagement.UI.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Dashboard"
    BackgroundColor="#F3F5F4">

    <ContentPage.Resources>
        <ResourceDictionary>
            <Style x:Key="DashboardCardStyle" TargetType="Border">
                <Setter Property="BackgroundColor" Value="White" />
                <Setter Property="Stroke" Value="#E7EBE8" />
                <Setter Property="StrokeThickness" Value="1" />
                <Setter Property="StrokeShape">
                    <Setter.Value>
                        <RoundRectangle CornerRadius="13" />
                    </Setter.Value>
                </Setter>
                <Setter Property="Padding" Value="13" />
            </Style>
            <Style x:Key="NavButtonStyle" TargetType="Button">
                <Setter Property="BackgroundColor" Value="Transparent" />
                <Setter Property="TextColor" Value="#7C8780" />
                <Setter Property="CornerRadius" Value="9" />
                <Setter Property="HorizontalOptions" Value="Fill" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Padding" Value="12,8" />
            </Style>
            <Style x:Key="NavChipStyle" TargetType="Button">
                <Setter Property="BackgroundColor" Value="White" />
                <Setter Property="TextColor" Value="#65716A" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Padding" Value="12,8" />
            </Style>
            <Style x:Key="TinyPeriodButtonStyle" TargetType="Button">
                <Setter Property="BackgroundColor" Value="#F4F6F4" />
                <Setter Property="TextColor" Value="#66736B" />
                <Setter Property="CornerRadius" Value="5" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Padding" Value="8,5" />
                <Setter Property="HeightRequest" Value="24" />
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid x:Name="RootLayout" ColumnDefinitions="190,*" RowDefinitions="*">
        <!-- Desktop navigation -->
        <Grid x:Name="Sidebar" Grid.Column="0" RowDefinitions="Auto,*,Auto"
              BackgroundColor="White" Padding="14,20,12,14">
            <VerticalStackLayout Spacing="5" Padding="8,0,0,22">
                <Label Text="SwapDigit" FontSize="27" FontAttributes="Bold" TextColor="#56A83B" />
                <Label Text="RESTAURANT MANAGEMENT" FontSize="16" CharacterSpacing="1.2"
                       TextColor="#9AA49E" />
                <Label Text="Ananda Food" FontSize="16" FontAttributes="Bold"
                       TextColor="#34433A" Margin="0,7,0,0" />
            </VerticalStackLayout>

            <VerticalStackLayout Grid.Row="1" Spacing="5">
                <Button Text="▦   Dashboard" Command="{Binding NavigateCommand}" CommandParameter="Dashboard"
                        BackgroundColor="#EFF2F0" TextColor="#26332D" CornerRadius="10"
                        HorizontalOptions="Fill" FontAttributes="Bold" />
                <Button Text="▤   Orders" Command="{Binding NavigateCommand}" CommandParameter="Orders"
                        Style="{StaticResource NavButtonStyle}" />
                <Button Text="▦   Tables" Command="{Binding NavigateCommand}" CommandParameter="Tables"
                        Style="{StaticResource NavButtonStyle}" />
                <Button Text="▤   Menu" Command="{Binding NavigateCommand}" CommandParameter="Menu"
                        Style="{StaticResource NavButtonStyle}" />
                <Button Text="☷   Inventory" Command="{Binding NavigateCommand}" CommandParameter="Inventory"
                        Style="{StaticResource NavButtonStyle}" />
                <Button Text="▣   Reservations" Command="{Binding NavigateCommand}" CommandParameter="Reservations"
                        Style="{StaticResource NavButtonStyle}" />
                <Button Text="♧   Customers" Command="{Binding NavigateCommand}" CommandParameter="Customers"
                        Style="{StaticResource NavButtonStyle}" />
                <Button Text="♙   Staff" Command="{Binding NavigateCommand}" CommandParameter="Staff"
                        Style="{StaticResource NavButtonStyle}" />
                <Button Text="⌁   Reports" Command="{Binding NavigateCommand}" CommandParameter="Reports"
                        Style="{StaticResource NavButtonStyle}" />
                <Button Text="⚙   Settings" Command="{Binding NavigateCommand}" CommandParameter="Settings"
                        Style="{StaticResource NavButtonStyle}" />
            </VerticalStackLayout>

            <Border Grid.Row="2" BackgroundColor="#67B83C" StrokeThickness="0"
                    StrokeShape="RoundRectangle 16" Padding="13">
                <VerticalStackLayout Spacing="6">
                    <Label Text="SUPPORT" FontSize="15" TextColor="#E8F7DF" />
                    <Label Text="Do you need help?" FontSize="19" FontAttributes="Bold"
                           TextColor="White" />
                    <Label Text="Contact support for assistance" FontSize="15"
                           TextColor="#F2FBEA" />
                    <Button Text="Get support" Command="{Binding SupportCommand}"
                            BackgroundColor="White" TextColor="#438E2B" CornerRadius="9"
                            FontSize="16" HeightRequest="34" />
                </VerticalStackLayout>
            </Border>
        </Grid>

        <!-- Main content -->
        <Grid Grid.Column="1" RowDefinitions="58,52,*" RowSpacing="0">
            <Grid Grid.Row="0" BackgroundColor="White" Padding="12,6"
                  ColumnDefinitions="*,Auto,Auto,Auto,Auto" ColumnSpacing="5">
                <Label x:Name="WelcomeLabel" Text="Welcome back, Here's what's happening today."
                       FontSize="15" TextColor="#7A8580" VerticalTextAlignment="Center" />
                <Border x:Name="SearchPanel" Grid.Column="1" Stroke="#E6EAE8" StrokeThickness="1"
                        StrokeShape="RoundRectangle 10" Padding="8,0" WidthRequest="170"
                        VerticalOptions="Center">
                    <Entry Placeholder="⌕  Search" Text="{Binding SearchText}"
                           FontSize="14" HeightRequest="34" />
                </Border>
                <Button Grid.Column="2" Text="♧" Command="{Binding NotificationCommand}"
                        BackgroundColor="Transparent" TextColor="#53635A" FontSize="19"
                        Padding="4,0" VerticalOptions="Center" />
                <Border x:Name="ProfilePanel" Grid.Column="3" StrokeThickness="0" BackgroundColor="#F1F5F1"
                        StrokeShape="RoundRectangle 11" Padding="6,4" HorizontalOptions="End" VerticalOptions="Center">
                    <HorizontalStackLayout Spacing="7" VerticalOptions="Center">
                        <Border BackgroundColor="#DDEBD6" StrokeThickness="0"
                                StrokeShape="RoundRectangle 9" WidthRequest="32" HeightRequest="32">
                            <Label Text="A" TextColor="#397D2A" FontAttributes="Bold" FontSize="16"
                                   HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                        </Border>
                        <VerticalStackLayout Spacing="0" VerticalOptions="Center">
                            <Label Text="Arthur" FontSize="13" FontAttributes="Bold"
                                   TextColor="#34433A" />
                            <Label Text="Owner" FontSize="10" TextColor="#718078" />
                        </VerticalStackLayout>
                    </HorizontalStackLayout>
                </Border>
                <Button x:Name="LogoutButton" Grid.Column="4" Text="⎋" Command="{Binding LogoutCommand}"
                        BackgroundColor="Transparent" TextColor="#53635A" FontSize="21"
                        Padding="5,0" VerticalOptions="Center" />
            </Grid>

                                <ScrollView x:Name="MobileNavigation" Grid.Row="1" IsVisible="False" Orientation="Horizontal" HorizontalScrollBarVisibility="Never" BackgroundColor="White">
                        <HorizontalStackLayout Spacing="6" Padding="10,4">
                            <Button Text="Dashboard" Command="{Binding NavigateCommand}" CommandParameter="Dashboard" Style="{StaticResource NavChipStyle}" />
                            <Button Text="Orders" Command="{Binding NavigateCommand}" CommandParameter="Orders" Style="{StaticResource NavChipStyle}" />
                            <Button Text="Tables" Command="{Binding NavigateCommand}" CommandParameter="Tables" Style="{StaticResource NavChipStyle}" />
                            <Button Text="Menu" Command="{Binding NavigateCommand}" CommandParameter="Menu" Style="{StaticResource NavChipStyle}" />
                            <Button Text="Inventory" Command="{Binding NavigateCommand}" CommandParameter="Inventory" Style="{StaticResource NavChipStyle}" />
                            <Button Text="Reservations" Command="{Binding NavigateCommand}" CommandParameter="Reservations" Style="{StaticResource NavChipStyle}" />
                            <Button Text="Customers" Command="{Binding NavigateCommand}" CommandParameter="Customers" Style="{StaticResource NavChipStyle}" />
                            <Button Text="Staff" Command="{Binding NavigateCommand}" CommandParameter="Staff" Style="{StaticResource NavChipStyle}" />
                            <Button Text="Reports" Command="{Binding NavigateCommand}" CommandParameter="Reports" Style="{StaticResource NavChipStyle}" />
                            <Button Text="Settings" Command="{Binding NavigateCommand}" CommandParameter="Settings" Style="{StaticResource NavChipStyle}" />
                        </HorizontalStackLayout>
                    </ScrollView>

            <ScrollView Grid.Row="2">
                <VerticalStackLayout Padding="16" Spacing="13">
                    <Label Text="{Binding SectionTitle}" FontSize="26" FontAttributes="Bold" TextColor="#222D27" />

                    <Border IsVisible="{Binding IsOtherSection}" BackgroundColor="White" Stroke="#E7EBE8" StrokeThickness="1" StrokeShape="RoundRectangle 14" Padding="22">
                        <VerticalStackLayout Spacing="10">
                            <Label Text="{Binding SectionTitle}" FontSize="22" FontAttributes="Bold" TextColor="#26332D" />
                            <Label Text="{Binding SectionDescription}" FontSize="15" TextColor="#7C8780" />
                            <Label Text="This section is ready for its UI module. Sample navigation is active; API and database integration will follow in the next phase." FontSize="16" TextColor="#7C8780" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- KPI cards -->
                    <Grid x:Name="StatsGrid" IsVisible="{Binding IsDashboardSection}" ColumnDefinitions="*,*,*,*" RowDefinitions="Auto,Auto" ColumnSpacing="9" RowSpacing="9">
                        <Border Grid.Column="0" Style="{StaticResource DashboardCardStyle}">
                            <VerticalStackLayout Spacing="7">
                                <Label Text="TODAY'S REVENUE" FontSize="15" CharacterSpacing="0.8" TextColor="#7C8780" />
                                <Label Text="₹12,304" FontSize="27" TextColor="#202923" />
                                <Label Text="↗  3.5%  than last day" FontSize="15" TextColor="#368C55" />
                            </VerticalStackLayout>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource DashboardCardStyle}">
                            <VerticalStackLayout Spacing="7">
                                <Label Text="ACTIVE ORDERS" FontSize="15" CharacterSpacing="0.8" TextColor="#7C8780" />
                                <Label Text="24" FontSize="27" TextColor="#202923" />
                                <HorizontalStackLayout Spacing="7">
                                    <Label Text="16 Online" FontSize="15" TextColor="#368C55" />
                                    <Label Text="7 Dine-in" FontSize="15" TextColor="#7B8580" />
                                    <Label Text="1 Takeaway" FontSize="15" TextColor="#7B8580" />
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                        </Border>
                        <Border Grid.Column="2" Style="{StaticResource DashboardCardStyle}">
                            <VerticalStackLayout Spacing="7">
                                <Label Text="TABLES OCCUPIED" FontSize="15" CharacterSpacing="0.8" TextColor="#7C8780" />
                                <Label Text="4/12" FontSize="27" TextColor="#202923" />
                                <Label Text="8 available" FontSize="15" TextColor="#7B8580" />
                            </VerticalStackLayout>
                        </Border>
                        <Border Grid.Column="3" Style="{StaticResource DashboardCardStyle}">
                            <VerticalStackLayout Spacing="7">
                                <Label Text="RESERVATIONS TODAY" FontSize="15" CharacterSpacing="0.8" TextColor="#7C8780" />
                                <Label Text="2" FontSize="27" TextColor="#202923" />
                                <Label Text="12 upcoming guests" FontSize="15" TextColor="#7B8580" />
                            </VerticalStackLayout>
                        </Border>
                    </Grid>

                    <!-- Revenue and orders -->
                    <Grid x:Name="AnalyticsGrid" IsVisible="{Binding IsDashboardSection}" ColumnDefinitions="1.2*,1*" RowDefinitions="Auto" ColumnSpacing="10">
                        <Border Grid.Column="0" Style="{StaticResource DashboardCardStyle}">
                            <VerticalStackLayout Spacing="11">
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Text="TODAY'S REVENUE" FontSize="16" CharacterSpacing="0.8" TextColor="#536159" FontAttributes="Bold" />
                                </Grid>
                                <Grid ColumnDefinitions="42,*" ColumnSpacing="10" HeightRequest="200">
                                    <Grid Grid.Column="0" RowDefinitions="*,*,*,*,*" RowSpacing="0">
                                        <Label Grid.Row="0" Text="80K" FontSize="14" TextColor="#748078" HorizontalTextAlignment="End" VerticalTextAlignment="Center" />
                                        <Label Grid.Row="1" Text="60K" FontSize="14" TextColor="#748078" HorizontalTextAlignment="End" VerticalTextAlignment="Center" />
                                        <Label Grid.Row="2" Text="40K" FontSize="14" TextColor="#748078" HorizontalTextAlignment="End" VerticalTextAlignment="Center" />
                                        <Label Grid.Row="3" Text="20K" FontSize="14" TextColor="#748078" HorizontalTextAlignment="End" VerticalTextAlignment="Center" />
                                        <Label Grid.Row="4" Text="0" FontSize="14" TextColor="#748078" HorizontalTextAlignment="End" VerticalTextAlignment="Center" />
                                    </Grid>
                                    <Grid Grid.Column="1" RowDefinitions="*,*,*,*,*" RowSpacing="0">
                                        <BoxView Grid.Row="0" HeightRequest="1" Color="#DDE5DF" VerticalOptions="Center" />
                                        <BoxView Grid.Row="1" HeightRequest="1" Color="#DDE5DF" VerticalOptions="Center" />
                                        <BoxView Grid.Row="2" HeightRequest="1" Color="#DDE5DF" VerticalOptions="Center" />
                                        <BoxView Grid.Row="3" HeightRequest="1" Color="#DDE5DF" VerticalOptions="Center" />
                                        <BoxView Grid.Row="4" HeightRequest="1" Color="#DDE5DF" VerticalOptions="Center" />
                                        <Grid Grid.RowSpan="5" ColumnDefinitions="*,*,*,*,*,*,*" VerticalOptions="Fill" ColumnSpacing="8" Padding="4,0">
                                            <BoxView Grid.Column="0" HeightRequest="76" VerticalOptions="End" BackgroundColor="#76B66A" />
                                            <BoxView Grid.Column="1" HeightRequest="112" VerticalOptions="End" BackgroundColor="#76B66A" />
                                            <BoxView Grid.Column="2" HeightRequest="91" VerticalOptions="End" BackgroundColor="#76B66A" />
                                            <BoxView Grid.Column="3" HeightRequest="145" VerticalOptions="End" BackgroundColor="#76B66A" />
                                            <BoxView Grid.Column="4" HeightRequest="108" VerticalOptions="End" BackgroundColor="#76B66A" />
                                            <BoxView Grid.Column="5" HeightRequest="128" VerticalOptions="End" BackgroundColor="#76B66A" />
                                            <BoxView Grid.Column="6" HeightRequest="95" VerticalOptions="End" BackgroundColor="#76B66A" />
                                        </Grid>
                                    </Grid>
                                </Grid>
                                <Grid ColumnDefinitions="42,*,*,*,*,*,*,*" ColumnSpacing="0">
                                    <Label Grid.Column="1" Text="Mon" FontSize="16" TextColor="#929C96" />
                                    <Label Grid.Column="2" Text="Tue" FontSize="16" TextColor="#929C96" />
                                    <Label Grid.Column="3" Text="Wed" FontSize="16" TextColor="#929C96" />
                                    <Label Grid.Column="4" Text="Thu" FontSize="16" TextColor="#929C96" />
                                    <Label Grid.Column="5" Text="Fri" FontSize="16" TextColor="#929C96" />
                                    <Label Grid.Column="6" Text="Sat" FontSize="16" TextColor="#929C96" />
                                    <Label Grid.Column="7" Text="Sun" FontSize="16" TextColor="#929C96" HorizontalTextAlignment="End" />
                                </Grid>
                            </VerticalStackLayout>
                        </Border>

                        <Border Grid.Column="1" Style="{StaticResource DashboardCardStyle}">
                            <VerticalStackLayout Spacing="10">
                                <Grid ColumnDefinitions="*">
                                    <Label Text="ORDERS" FontSize="16" CharacterSpacing="0.8"
                                           TextColor="#536159" FontAttributes="Bold" />
                                </Grid>
                                <Label Text="24" FontSize="29" TextColor="#202923" />
                                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                                    <VerticalStackLayout Spacing="4">
                                        <Label Text="Delivery" FontSize="15" TextColor="#65716A" />
                                        <Label Text="16  ━━━━━" FontSize="15" TextColor="#E77D28" />
                                        <Label Text="65%" FontSize="16" TextColor="#929C96" />
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Column="1" Spacing="4">
                                        <Label Text="Dine-in" FontSize="15" TextColor="#65716A" />
                                        <Label Text="7  ━━━" FontSize="15" TextColor="#D9B52E" />
                                        <Label Text="30%" FontSize="16" TextColor="#929C96" />
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Column="2" Spacing="4">
                                        <Label Text="Takeaway" FontSize="15" TextColor="#65716A" />
                                        <Label Text="1  ━" FontSize="15" TextColor="#4AA65A" />
                                        <Label Text="5%" FontSize="16" TextColor="#929C96" />
                                    </VerticalStackLayout>
                                </Grid>
                                <BoxView HeightRequest="1" Color="#EDF0EE" />
                                <Label Text="RECENT ORDERS" FontSize="15" CharacterSpacing="0.7"
                                       TextColor="#536159" FontAttributes="Bold" />
                                <Grid ColumnDefinitions="1.3*,0.9*,1*,0.85*" ColumnSpacing="6">
                                    <Label Text="Order ID" FontSize="11" TextColor="#9AA39E" />
                                    <Label Grid.Column="1" Text="Qty" FontSize="11" TextColor="#9AA39E" />
                                    <Label Grid.Column="2" Text="Type" FontSize="11" TextColor="#9AA39E" />
                                    <Label Grid.Column="3" Text="Price" FontSize="11" TextColor="#9AA39E" />
                                </Grid>
                                <Grid ColumnDefinitions="1.25*,0.65*,1*,0.75*" ColumnSpacing="4">
                                    <Label Text="◉ OE 69820" FontSize="12" TextColor="#45534A" />
                                    <Label Grid.Column="1" Text="3 items" FontSize="12" TextColor="#45534A" />
                                    <Label Grid.Column="2" Text="Delivery" FontSize="12" TextColor="#45534A" />
                                    <Label Grid.Column="3" Text="$56.5" FontSize="12" TextColor="#45534A" />
                                </Grid>
                                <Grid ColumnDefinitions="1.25*,0.65*,1*,0.75*" ColumnSpacing="4">
                                    <Label Text="◉ OE 69819" FontSize="12" TextColor="#45534A" />
                                    <Label Grid.Column="1" Text="2 items" FontSize="12" TextColor="#45534A" />
                                    <Label Grid.Column="2" Text="Dine-in" FontSize="12" TextColor="#45534A" />
                                    <Label Grid.Column="3" Text="$38.5" FontSize="12" TextColor="#45534A" />
                                </Grid>
                                <Grid ColumnDefinitions="1.25*,0.65*,1*,0.75*" ColumnSpacing="4">
                                    <Label Text="◉ OE 69818" FontSize="12" TextColor="#45534A" />
                                    <Label Grid.Column="1" Text="2 items" FontSize="12" TextColor="#45534A" />
                                    <Label Grid.Column="2" Text="Takeaway" FontSize="12" TextColor="#45534A" />
                                    <Label Grid.Column="3" Text="$65" FontSize="12" TextColor="#45534A" />
                                </Grid>
                            </VerticalStackLayout>
                        </Border>
                    </Grid>

                    <!-- Reservations and popular items -->
                    <Grid x:Name="BottomGrid" IsVisible="{Binding IsDashboardSection}" ColumnDefinitions="1.25*,1*" RowDefinitions="Auto" ColumnSpacing="10">
                        <Border Grid.Column="0" Style="{StaticResource DashboardCardStyle}">
                            <VerticalStackLayout Spacing="11">
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Text="TODAY'S RESERVATIONS" FontSize="16" CharacterSpacing="0.7"
                                           TextColor="#536159" FontAttributes="Bold" />
                                    <Button Grid.Column="1" Text="+ Add Reservation"
                                            Command="{Binding AddReservationCommand}"
                                            BackgroundColor="#202923" TextColor="White"
                                            CornerRadius="8" FontSize="15" Padding="10,6" />
                                </Grid>
                                <Grid ColumnDefinitions="1.25*,0.65*,1*,0.75*" ColumnSpacing="4">
                                    <Label Text="Booking ID" FontSize="11" TextColor="#9AA39E" />
                                    <Label Grid.Column="1" Text="Date &amp; time" FontSize="11" TextColor="#9AA39E" />
                                    <Label Grid.Column="2" Text="Table" FontSize="11" TextColor="#9AA39E" />
                                    <Label Grid.Column="3" Text="Status" FontSize="11" TextColor="#9AA39E" />
                                </Grid>
                                <Grid ColumnDefinitions="1.25*,0.65*,1*,0.75*" ColumnSpacing="4">
                                    <Label Text="Michael Chen" FontSize="12" TextColor="#45534A" />
                                    <Label Grid.Column="1" Text="Feb 8, 12:30" FontSize="12" TextColor="#45534A" />
                                    <Label Grid.Column="2" Text="Table 5" FontSize="12" TextColor="#45534A" />
                                    <Label Grid.Column="3" Text="✅ Confirmed" FontSize="11" TextColor="#25834A" />
                                </Grid>
                                <Grid ColumnDefinitions="1.25*,0.65*,1*,0.75*" ColumnSpacing="4">
                                    <Label Text="Olivia Martin" FontSize="12" TextColor="#45534A" />
                                    <Label Grid.Column="1" Text="Feb 8, 1:00" FontSize="12" TextColor="#45534A" />
                                    <Label Grid.Column="2" Text="—" FontSize="12" TextColor="#45534A" />
                                    <Label Grid.Column="3" Text="⏳ Pending" FontSize="11" TextColor="#D48B28" />
                                </Grid>
                                <Grid ColumnDefinitions="1.25*,0.65*,1*,0.75*" ColumnSpacing="4">
                                    <Label Text="Daniel Smith" FontSize="12" TextColor="#45534A" />
                                    <Label Grid.Column="1" Text="Feb 8, 1:30" FontSize="12" TextColor="#45534A" />
                                    <Label Grid.Column="2" Text="Table 5" FontSize="12" TextColor="#45534A" />
                                    <Label Grid.Column="3" Text="✖ Canceled" FontSize="11" TextColor="#C6534D" />
                                </Grid>
                            </VerticalStackLayout>
                        </Border>

                        <Border Grid.Column="1" Style="{StaticResource DashboardCardStyle}">
                            <VerticalStackLayout Spacing="10">
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Text="POPULAR ITEMS" FontSize="16" CharacterSpacing="0.7"
                                           TextColor="#536159" FontAttributes="Bold" />
                                    <Label Grid.Column="1" Text="1D   1W" FontSize="16" TextColor="#929C96" />
                                </Grid>
                                <Grid ColumnDefinitions="*,Auto">
                                    <VerticalStackLayout Spacing="3">
                                        <Label Text="🍣  Sushi and Sashimi" FontSize="12" TextColor="#45534A" />
                                        <Label Text="       87 orders" FontSize="12" TextColor="#9AA39E" />
                                    </VerticalStackLayout>
                                    <Label Grid.Column="1" Text="↗ 3.5%" FontSize="15" TextColor="#368C55" />
                                </Grid>
                                <Grid ColumnDefinitions="*,Auto">
                                    <VerticalStackLayout Spacing="3">
                                        <Label Text="🐟  Grilled Salmon" FontSize="12" TextColor="#45534A" />
                                        <Label Text="       65 orders" FontSize="12" TextColor="#9AA39E" />
                                    </VerticalStackLayout>
                                    <Label Grid.Column="1" Text="↗ 1.5%" FontSize="15" TextColor="#368C55" />
                                </Grid>
                                <Grid ColumnDefinitions="*,Auto">
                                    <VerticalStackLayout Spacing="3">
                                        <Label Text="🥗  Caesar Salad" FontSize="12" TextColor="#45534A" />
                                        <Label Text="       42 orders" FontSize="12" TextColor="#9AA39E" />
                                    </VerticalStackLayout>
                                    <Label Grid.Column="1" Text="↘ 0.5%" FontSize="15" TextColor="#C75A50" />
                                </Grid>
                                <Grid ColumnDefinitions="*,Auto">
                                    <VerticalStackLayout Spacing="3">
                                        <Label Text="🍰  Tiramisu" FontSize="12" TextColor="#45534A" />
                                        <Label Text="       32 orders" FontSize="12" TextColor="#9AA39E" />
                                    </VerticalStackLayout>
                                    <Label Grid.Column="1" Text="↗ 0.3%" FontSize="15" TextColor="#368C55" />
                                </Grid>
                            </VerticalStackLayout>
                        </Border>
                    </Grid>

                    <Label Text="UI preview • Sample dashboard data only"
                           FontSize="15" TextColor="#A0AAA4" HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </ScrollView>
        </Grid>
    <Border IsVisible="{Binding HasFeedback}" BackgroundColor="#26332D" StrokeThickness="0" StrokeShape="RoundRectangle 12" Padding="14,10" HorizontalOptions="Center" VerticalOptions="Start" Margin="16,12,16,0" ZIndex="20"><Label Text="{Binding FeedbackMessage}" TextColor="White" FontSize="15" /></Border>
    </Grid>


</ContentPage>