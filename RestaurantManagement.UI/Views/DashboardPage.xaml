<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="RestaurantManagement.UI.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Dashboard"
    BackgroundColor="#F3F5F4">

    <ContentPage.Resources>
        <ResourceDictionary>
            <Style x:Key="DashboardCardStyle" TargetType="Border">
                <Setter Property="BackgroundColor" Value="White" />
                <Setter Property="Stroke" Value="#E7EBE8" />
                <Setter Property="StrokeThickness" Value="1" />
                <Setter Property="StrokeShape">
                    <Setter.Value>
                        <RoundRectangle CornerRadius="13" />
                    </Setter.Value>
                </Setter>
                <Setter Property="Padding" Value="13" />
            </Style>
            <Style x:Key="NavButtonStyle" TargetType="Button">
                <Setter Property="BackgroundColor" Value="Transparent" />
                <Setter Property="TextColor" Value="#7C8780" />
                <Setter Property="CornerRadius" Value="9" />
                <Setter Property="HorizontalOptions" Value="Fill" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="HorizontalTextAlignment" Value="Start" />
                <Setter Property="Padding" Value="5,8" />
            </Style>
            <Style x:Key="NavChipStyle" TargetType="Button">
                <Setter Property="BackgroundColor" Value="White" />
                <Setter Property="TextColor" Value="#65716A" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Padding" Value="12,8" />
            </Style>
            <Style x:Key="TinyPeriodButtonStyle" TargetType="Button">
                <Setter Property="BackgroundColor" Value="#F4F6F4" />
                <Setter Property="TextColor" Value="#66736B" />
                <Setter Property="CornerRadius" Value="5" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Padding" Value="8,5" />
                <Setter Property="HeightRequest" Value="24" />
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid x:Name="RootLayout" ColumnDefinitions="190,*" RowDefinitions="*">
        <!-- Desktop navigation -->
        <Grid x:Name="Sidebar" Grid.Column="0" RowDefinitions="Auto,*" BackgroundColor="White" Padding="14,20,12,14">
            <VerticalStackLayout Spacing="4" Padding="8,0,0,18">
                <Label Text="SwapDigit" FontSize="25" FontAttributes="Bold" TextColor="#56A83B" />
                <Label Text="RESTAURANT MANAGEMENT" FontSize="10" CharacterSpacing="1" TextColor="#9AA49E" />
                <Label Text="Ananda Food" FontSize="14" FontAttributes="Bold" TextColor="#34433A" Margin="0,7,0,0" />
            </VerticalStackLayout>
            <ScrollView Grid.Row="1" VerticalScrollBarVisibility="Always">
                <VerticalStackLayout Spacing="5">
                    <Grid ColumnDefinitions="30,*" HeightRequest="42"><Label Text="&#xE80F;" FontFamily="Segoe MDL2 Assets" FontSize="17" TextColor="#65716A" VerticalTextAlignment="Center" HorizontalTextAlignment="Center"/><Button Grid.Column="1" Text="Dashboard" Command="{Binding NavigateCommand}" CommandParameter="Dashboard" Style="{StaticResource NavButtonStyle}"/></Grid>
                    <Grid ColumnDefinitions="30,*" HeightRequest="42"><Label Text="&#xE1D3;" FontFamily="Segoe MDL2 Assets" FontSize="17" TextColor="#65716A" VerticalTextAlignment="Center" HorizontalTextAlignment="Center"/><Button Grid.Column="1" Text="Orders" Command="{Binding NavigateCommand}" CommandParameter="Orders" Style="{StaticResource NavButtonStyle}"/></Grid>
                    <Grid ColumnDefinitions="30,*" HeightRequest="42"><Label Text="&#xE80A;" FontFamily="Segoe MDL2 Assets" FontSize="17" TextColor="#65716A" VerticalTextAlignment="Center" HorizontalTextAlignment="Center"/><Button Grid.Column="1" Text="Tables" Command="{Binding NavigateCommand}" CommandParameter="Tables" Style="{StaticResource NavButtonStyle}"/></Grid>
                    <Grid ColumnDefinitions="30,*" HeightRequest="42"><Label Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="17" TextColor="#65716A" VerticalTextAlignment="Center" HorizontalTextAlignment="Center"/><Button Grid.Column="1" Text="Menu" Command="{Binding NavigateCommand}" CommandParameter="Menu" Style="{StaticResource NavButtonStyle}"/></Grid>
                    <Grid ColumnDefinitions="30,*" HeightRequest="42"><Label Text="&#xE7B8;" FontFamily="Segoe MDL2 Assets" FontSize="17" TextColor="#65716A" VerticalTextAlignment="Center" HorizontalTextAlignment="Center"/><Button Grid.Column="1" Text="Inventory" Command="{Binding NavigateCommand}" CommandParameter="Inventory" Style="{StaticResource NavButtonStyle}"/></Grid>
                    <Grid ColumnDefinitions="30,*" HeightRequest="42"><Label Text="&#xE787;" FontFamily="Segoe MDL2 Assets" FontSize="17" TextColor="#65716A" VerticalTextAlignment="Center" HorizontalTextAlignment="Center"/><Button Grid.Column="1" Text="Reservations" Command="{Binding NavigateCommand}" CommandParameter="Reservations" Style="{StaticResource NavButtonStyle}"/></Grid>
                    <Grid ColumnDefinitions="30,*" HeightRequest="42"><Label Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="17" TextColor="#65716A" VerticalTextAlignment="Center" HorizontalTextAlignment="Center"/><Button Grid.Column="1" Text="Customers" Command="{Binding NavigateCommand}" CommandParameter="Customers" Style="{StaticResource NavButtonStyle}"/></Grid>
                    <Grid ColumnDefinitions="30,*" HeightRequest="42"><Label Text="&#xE716;" FontFamily="Segoe MDL2 Assets" FontSize="17" TextColor="#65716A" VerticalTextAlignment="Center" HorizontalTextAlignment="Center"/><Button Grid.Column="1" Text="Staff" Command="{Binding NavigateCommand}" CommandParameter="Staff" Style="{StaticResource NavButtonStyle}"/></Grid>
                    <Grid ColumnDefinitions="30,*" HeightRequest="42"><Label Text="&#xE9D2;" FontFamily="Segoe MDL2 Assets" FontSize="17" TextColor="#65716A" VerticalTextAlignment="Center" HorizontalTextAlignment="Center"/><Button Grid.Column="1" Text="Reports" Command="{Binding NavigateCommand}" CommandParameter="Reports" Style="{StaticResource NavButtonStyle}"/></Grid>
                    <Grid ColumnDefinitions="30,*" HeightRequest="42"><Label Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="17" TextColor="#65716A" VerticalTextAlignment="Center" HorizontalTextAlignment="Center"/><Button Grid.Column="1" Text="Settings" Command="{Binding NavigateCommand}" CommandParameter="Settings" Style="{StaticResource NavButtonStyle}"/></Grid>
                </VerticalStackLayout>
            </ScrollView>
        </Grid>
        <!-- Main content -->
        <Grid Grid.Column="1" RowDefinitions="58,52,*" RowSpacing="0">
            <Grid Grid.Row="0" BackgroundColor="White" Padding="12,6"
                  ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="5">
                <Label x:Name="WelcomeLabel" Text="Welcome back, Here's what's happening today."
                       FontSize="15" TextColor="#7A8580" VerticalTextAlignment="Center" />
                <Border x:Name="SearchPanel" Grid.Column="1" StrokeThickness="0"
                        StrokeShape="RoundRectangle 10" Padding="8,0" WidthRequest="170"
                        VerticalOptions="Center">
                    <Grid RowDefinitions="*,1" VerticalOptions="Center"><Entry Grid.Row="0" Placeholder="Search" Text="{Binding SearchText}" BackgroundColor="Transparent" FontSize="14" HeightRequest="34" /><BoxView Grid.Row="1" BackgroundColor="#AEBBB4" HeightRequest="1" HorizontalOptions="Fill" /></Grid>
                </Border>
                <Button Grid.Column="2" Text="&#xE7F4;" FontFamily="Segoe MDL2 Assets" Command="{Binding NotificationCommand}"
                        BackgroundColor="Transparent" TextColor="#53635A" FontSize="19"
                        Padding="4,0" VerticalOptions="Center" />
                <VerticalStackLayout x:Name="UserMenuHost" Grid.Column="3" Spacing="3" HorizontalOptions="End" VerticalOptions="Center">
                    <Border x:Name="ProfilePanel" StrokeThickness="0" BackgroundColor="#F1F5F1" StrokeShape="RoundRectangle 11" Padding="6,4">
                        <HorizontalStackLayout Spacing="7" VerticalOptions="Center">
                            <Border BackgroundColor="#DDEBD6" StrokeThickness="0" StrokeShape="RoundRectangle 9" WidthRequest="32" HeightRequest="32">
                                <Label Text="A" TextColor="#397D2A" FontAttributes="Bold" FontSize="16" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                            </Border>
                            <VerticalStackLayout Spacing="0"><Label Text="Arthur" FontSize="13" FontAttributes="Bold" TextColor="#34433A" /><Label Text="Owner" FontSize="10" TextColor="#718078" /></VerticalStackLayout>
                            <Label Text="&#xE70D;" FontFamily="Segoe MDL2 Assets" FontSize="11" TextColor="#65716A" VerticalTextAlignment="Center" />
                        </HorizontalStackLayout>
                    </Border>
                    <Border x:Name="UserMenu" IsVisible="False" BackgroundColor="White" Stroke="#E7EBE8" StrokeThickness="1" StrokeShape="RoundRectangle 9" Padding="3" HorizontalOptions="End">
                        <Button Text="&#xE8AC;  Logout" FontFamily="Segoe MDL2 Assets" Command="{Binding LogoutCommand}" BackgroundColor="Transparent" TextColor="#53635A" FontSize="13" HorizontalOptions="Fill" />
                    </Border>
                    <VerticalStackLayout.GestureRecognizers>
                        <PointerGestureRecognizer PointerEntered="ShowUserMenu" PointerExited="HideUserMenu" />
                        <TapGestureRecognizer Tapped="ToggleUserMenu" />
                    </VerticalStackLayout.GestureRecognizers>
                </VerticalStackLayout>
            </Grid>

                                <ScrollView x:Name="MobileNavigation" Grid.Row="1" IsVisible="False" Orientation="Horizontal" HorizontalScrollBarVisibility="Never" BackgroundColor="White">
                        <HorizontalStackLayout Spacing="6" Padding="10,4">
                            <Button Text="Dashboard" Command="{Binding NavigateCommand}" CommandParameter="Dashboard" Style="{StaticResource NavChipStyle}" />
                            <Button Text="Orders" Command="{Binding NavigateCommand}" CommandParameter="Orders" Style="{StaticResource NavChipStyle}" />
                            <Button Text="Tables" Command="{Binding NavigateCommand}" CommandParameter="Tables" Style="{StaticResource NavChipStyle}" />
                            <Button Text="Menu" Command="{Binding NavigateCommand}" CommandParameter="Menu" Style="{StaticResource NavChipStyle}" />
                            <Button Text="Inventory" Command="{Binding NavigateCommand}" CommandParameter="Inventory" Style="{StaticResource NavChipStyle}" />
                            <Button Text="Reservations" Command="{Binding NavigateCommand}" CommandParameter="Reservations" Style="{StaticResource NavChipStyle}" />
                            <Button Text="Customers" Command="{Binding NavigateCommand}" CommandParameter="Customers" Style="{StaticResource NavChipStyle}" />
                            <Button Text="Staff" Command="{Binding NavigateCommand}" CommandParameter="Staff" Style="{StaticResource NavChipStyle}" />
                            <Button Text="Reports" Command="{Binding NavigateCommand}" CommandParameter="Reports" Style="{StaticResource NavChipStyle}" />
                            <Button Text="Settings" Command="{Binding NavigateCommand}" CommandParameter="Settings" Style="{StaticResource NavChipStyle}" />
                        </HorizontalStackLayout>
                    </ScrollView>

            <ScrollView Grid.Row="2">
                <VerticalStackLayout Padding="16" Spacing="13">
                    <Label Text="{Binding SectionTitle}" IsVisible="{Binding IsOtherSection}" FontSize="26" FontAttributes="Bold" TextColor="#222D27" />

                    <Border IsVisible="{Binding IsOtherSection}" BackgroundColor="White" Stroke="#E7EBE8" StrokeThickness="1" StrokeShape="RoundRectangle 14" Padding="22">
                        <VerticalStackLayout Spacing="10">
                            <Label Text="{Binding SectionTitle}" FontSize="22" FontAttributes="Bold" TextColor="#26332D" />
                            <Label Text="{Binding SectionDescription}" FontSize="15" TextColor="#7C8780" />
                            <Label Text="This section is ready for its UI module. Sample navigation is active; API and database integration will follow in the next phase." FontSize="16" TextColor="#7C8780" />
                        </VerticalStackLayout>
                    </Border>


                    <VerticalStackLayout x:Name="TableDashboard" IsVisible="{Binding IsTablesSection}" Spacing="13">
                        <Grid x:Name="TableStatsGrid" ColumnDefinitions="*,*,*,*" ColumnSpacing="9">
                            <Border Style="{StaticResource DashboardCardStyle}"><VerticalStackLayout><Label Text="TOTAL TABLES" FontSize="13" TextColor="#7C8780"/><Label Text="12" FontSize="26" FontAttributes="Bold" TextColor="#26332D"/></VerticalStackLayout></Border>
                            <Border Grid.Column="1" Style="{StaticResource DashboardCardStyle}"><VerticalStackLayout><Label Text="AVAILABLE" FontSize="13" TextColor="#7C8780"/><Label Text="6" FontSize="26" FontAttributes="Bold" TextColor="#368C55"/></VerticalStackLayout></Border>
                            <Border Grid.Column="2" Style="{StaticResource DashboardCardStyle}"><VerticalStackLayout><Label Text="OCCUPIED" FontSize="13" TextColor="#7C8780"/><Label Text="4" FontSize="26" FontAttributes="Bold" TextColor="#C6534D"/></VerticalStackLayout></Border>
                            <Border Grid.Column="3" Style="{StaticResource DashboardCardStyle}"><VerticalStackLayout><Label Text="RESERVED" FontSize="13" TextColor="#7C8780"/><Label Text="2" FontSize="26" FontAttributes="Bold" TextColor="#D48B28"/></VerticalStackLayout></Border>
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto"><Label Text="All Tables" FontSize="19" FontAttributes="Bold" TextColor="#26332D"/><HorizontalStackLayout Grid.Column="1" Spacing="8"><Label Text="● Available" FontSize="12" TextColor="#368C55"/><Label Text="● Occupied" FontSize="12" TextColor="#C6534D"/><Label Text="● Reserved" FontSize="12" TextColor="#D48B28"/></HorizontalStackLayout></Grid>
                        <Grid x:Name="TableCardsGrid" ColumnDefinitions="*,*,*,*" ColumnSpacing="9" RowSpacing="9">
                            <Border Style="{StaticResource DashboardCardStyle}"><VerticalStackLayout Spacing="7"><Label Text="Table 01  •  Available" FontSize="15" FontAttributes="Bold" TextColor="#368C55"/><Label Text="4 seats • Ready" FontSize="12" TextColor="#7C8780"/><Button Text="Open Table" Command="{Binding TableActionCommand}" CommandParameter="Table 01" BackgroundColor="#EAF3E6" TextColor="#397D2A" FontSize="12"/></VerticalStackLayout></Border>
                            <Border Grid.Column="1" Style="{StaticResource DashboardCardStyle}"><VerticalStackLayout Spacing="7"><Label Text="Table 02  •  Occupied" FontSize="15" FontAttributes="Bold" TextColor="#C6534D"/><Label Text="2 guests • 18 min" FontSize="12" TextColor="#7C8780"/><Button Text="View Order" Command="{Binding TableActionCommand}" CommandParameter="Table 02" BackgroundColor="#FCEDEC" TextColor="#B94B45" FontSize="12"/></VerticalStackLayout></Border>
                            <Border Grid.Column="2" Style="{StaticResource DashboardCardStyle}"><VerticalStackLayout Spacing="7"><Label Text="Table 03  •  Reserved" FontSize="15" FontAttributes="Bold" TextColor="#D48B28"/><Label Text="4 guests • 7:30 PM" FontSize="12" TextColor="#7C8780"/><Button Text="View Booking" Command="{Binding TableActionCommand}" CommandParameter="Table 03" BackgroundColor="#FFF4E3" TextColor="#A86B16" FontSize="12"/></VerticalStackLayout></Border>
                            <Border Grid.Column="3" Style="{StaticResource DashboardCardStyle}"><VerticalStackLayout Spacing="7"><Label Text="Table 04  •  Available" FontSize="15" FontAttributes="Bold" TextColor="#368C55"/><Label Text="2 seats • Ready" FontSize="12" TextColor="#7C8780"/><Button Text="Open Table" Command="{Binding TableActionCommand}" CommandParameter="Table 04" BackgroundColor="#EAF3E6" TextColor="#397D2A" FontSize="12"/></VerticalStackLayout></Border>
                            <Border Grid.Row="1" Style="{StaticResource DashboardCardStyle}"><VerticalStackLayout Spacing="7"><Label Text="Table 05  •  Occupied" FontSize="15" FontAttributes="Bold" TextColor="#C6534D"/><Label Text="3 guests • 32 min" FontSize="12" TextColor="#7C8780"/><Button Text="View Order" Command="{Binding TableActionCommand}" CommandParameter="Table 05" BackgroundColor="#FCEDEC" TextColor="#B94B45" FontSize="12"/></VerticalStackLayout></Border>
                            <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource DashboardCardStyle}"><VerticalStackLayout Spacing="7"><Label Text="Table 06  •  Available" FontSize="15" FontAttributes="Bold" TextColor="#368C55"/><Label Text="4 seats • Ready" FontSize="12" TextColor="#7C8780"/><Button Text="Open Table" Command="{Binding TableActionCommand}" CommandParameter="Table 06" BackgroundColor="#EAF3E6" TextColor="#397D2A" FontSize="12"/></VerticalStackLayout></Border>
                            <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource DashboardCardStyle}"><VerticalStackLayout Spacing="7"><Label Text="Table 07  •  Reserved" FontSize="15" FontAttributes="Bold" TextColor="#D48B28"/><Label Text="2 guests • 8:00 PM" FontSize="12" TextColor="#7C8780"/><Button Text="View Booking" Command="{Binding TableActionCommand}" CommandParameter="Table 07" BackgroundColor="#FFF4E3" TextColor="#A86B16" FontSize="12"/></VerticalStackLayout></Border>
                            <Border Grid.Row="1" Grid.Column="3" Style="{StaticResource DashboardCardStyle}"><VerticalStackLayout Spacing="7"><Label Text="Table 08  •  Occupied" FontSize="15" FontAttributes="Bold" TextColor="#C6534D"/><Label Text="2 guests • 11 min" FontSize="12" TextColor="#7C8780"/><Button Text="View Order" Command="{Binding TableActionCommand}" CommandParameter="Table 08" BackgroundColor="#FCEDEC" TextColor="#B94B45" FontSize="12"/></VerticalStackLayout></Border>
                            <Border Grid.Row="2" Style="{StaticResource DashboardCardStyle}"><VerticalStackLayout Spacing="7"><Label Text="Table 09  •  Available" FontSize="15" FontAttributes="Bold" TextColor="#368C55"/><Label Text="6 seats • Ready" FontSize="12" TextColor="#7C8780"/><Button Text="Open Table" Command="{Binding TableActionCommand}" CommandParameter="Table 09" BackgroundColor="#EAF3E6" TextColor="#397D2A" FontSize="12"/></VerticalStackLayout></Border>
                            <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource DashboardCardStyle}"><VerticalStackLayout Spacing="7"><Label Text="Table 10  •  Available" FontSize="15" FontAttributes="Bold" TextColor="#368C55"/><Label Text="2 seats • Ready" FontSize="12" TextColor="#7C8780"/><Button Text="Open Table" Command="{Binding TableActionCommand}" CommandParameter="Table 10" BackgroundColor="#EAF3E6" TextColor="#397D2A" FontSize="12"/></VerticalStackLayout></Border>
                            <Border Grid.Row="2" Grid.Column="2" Style="{StaticResource DashboardCardStyle}"><VerticalStackLayout Spacing="7"><Label Text="Table 11  •  Occupied" FontSize="15" FontAttributes="Bold" TextColor="#C6534D"/><Label Text="4 guests • 25 min" FontSize="12" TextColor="#7C8780"/><Button Text="View Order" Command="{Binding TableActionCommand}" CommandParameter="Table 11" BackgroundColor="#FCEDEC" TextColor="#B94B45" FontSize="12"/></VerticalStackLayout></Border>
                            <Border Grid.Row="2" Grid.Column="3" Style="{StaticResource DashboardCardStyle}"><VerticalStackLayout Spacing="7"><Label Text="Table 12  •  Available" FontSize="15" FontAttributes="Bold" TextColor="#368C55"/><Label Text="4 seats • Ready" FontSize="12" TextColor="#7C8780"/><Button Text="Open Table" Command="{Binding TableActionCommand}" CommandParameter="Table 12" BackgroundColor="#EAF3E6" TextColor="#397D2A" FontSize="12"/></VerticalStackLayout></Border>
                        </Grid>
                    </VerticalStackLayout>

                    <!-- KPI cards -->
                    <Grid x:Name="StatsGrid" IsVisible="{Binding IsDashboardSection}" ColumnDefinitions="*,*,*,*" RowDefinitions="Auto,Auto" ColumnSpacing="9" RowSpacing="9">
                        <Border Grid.Column="0" Style="{StaticResource DashboardCardStyle}">
                            <VerticalStackLayout Spacing="7">
                                <Label Text="TODAY'S REVENUE" FontSize="15" CharacterSpacing="0.8" TextColor="#7C8780" />
                                <Label Text="₹12,304" FontSize="27" TextColor="#202923" />
                                <Label Text="↗  3.5%  than last day" FontSize="15" TextColor="#368C55" />
                            </VerticalStackLayout>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource DashboardCardStyle}">
                            <VerticalStackLayout Spacing="7">
                                <Label Text="ACTIVE ORDERS" FontSize="15" CharacterSpacing="0.8" TextColor="#7C8780" />
                                <Label Text="24" FontSize="27" TextColor="#202923" />
                                <HorizontalStackLayout Spacing="7">
                                    <Label Text="16 Online" FontSize="15" TextColor="#368C55" />
                                    <Label Text="7 Dine-in" FontSize="15" TextColor="#7B8580" />
                                    <Label Text="1 Takeaway" FontSize="15" TextColor="#7B8580" />
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                        </Border>
                        <Border Grid.Column="2" Style="{StaticResource DashboardCardStyle}">
                            <VerticalStackLayout Spacing="7">
                                <Label Text="TABLES OCCUPIED" FontSize="15" CharacterSpacing="0.8" TextColor="#7C8780" />
                                <Label Text="4/12" FontSize="27" TextColor="#202923" />
                                <Label Text="8 available" FontSize="15" TextColor="#7B8580" />
                            </VerticalStackLayout>
                        </Border>
                        <Border Grid.Column="3" Style="{StaticResource DashboardCardStyle}">
                            <VerticalStackLayout Spacing="7">
                                <Label Text="RESERVATIONS TODAY" FontSize="15" CharacterSpacing="0.8" TextColor="#7C8780" />
                                <Label Text="2" FontSize="27" TextColor="#202923" />
                                <Label Text="12 upcoming guests" FontSize="15" TextColor="#7B8580" />
                            </VerticalStackLayout>
                        </Border>
                    </Grid>

                    <!-- Revenue and orders -->
                    <Grid x:Name="AnalyticsGrid" IsVisible="{Binding IsDashboardSection}" ColumnDefinitions="1.2*,1*" RowDefinitions="Auto" ColumnSpacing="10">
                        <Border Grid.Column="0" Style="{StaticResource DashboardCardStyle}">
                            <VerticalStackLayout Spacing="11">
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Text="TODAY'S REVENUE" FontSize="16" CharacterSpacing="0.8" TextColor="#536159" FontAttributes="Bold" />
                                </Grid>
                                <Grid ColumnDefinitions="42,*" ColumnSpacing="10" HeightRequest="200">
                                    <Grid Grid.Column="0" RowDefinitions="*,*,*,*,*" RowSpacing="0">
                                        <Label Grid.Row="0" Text="80K" FontSize="14" TextColor="#748078" HorizontalTextAlignment="End" VerticalTextAlignment="Center" />
                                        <Label Grid.Row="1" Text="60K" FontSize="14" TextColor="#748078" HorizontalTextAlignment="End" VerticalTextAlignment="Center" />
                                        <Label Grid.Row="2" Text="40K" FontSize="14" TextColor="#748078" HorizontalTextAlignment="End" VerticalTextAlignment="Center" />
                                        <Label Grid.Row="3" Text="20K" FontSize="14" TextColor="#748078" HorizontalTextAlignment="End" VerticalTextAlignment="Center" />
                                        <Label Grid.Row="4" Text="0" FontSize="14" TextColor="#748078" HorizontalTextAlignment="End" VerticalTextAlignment="Center" />
                                    </Grid>
                                    <Grid Grid.Column="1" RowDefinitions="*,*,*,*,*" RowSpacing="0">
                                        <BoxView Grid.Row="0" HeightRequest="1" Color="#DDE5DF" VerticalOptions="Center" />
                                        <BoxView Grid.Row="1" HeightRequest="1" Color="#DDE5DF" VerticalOptions="Center" />
                                        <BoxView Grid.Row="2" HeightRequest="1" Color="#DDE5DF" VerticalOptions="Center" />
                                        <BoxView Grid.Row="3" HeightRequest="1" Color="#DDE5DF" VerticalOptions="Center" />
                                        <BoxView Grid.Row="4" HeightRequest="1" Color="#DDE5DF" VerticalOptions="Center" />
                                        <Grid Grid.RowSpan="5" ColumnDefinitions="*,*,*,*,*,*,*" VerticalOptions="Fill" ColumnSpacing="8" Padding="4,0">
                                            <BoxView Grid.Column="0" HeightRequest="76" VerticalOptions="End" BackgroundColor="#76B66A" />
                                            <BoxView Grid.Column="1" HeightRequest="112" VerticalOptions="End" BackgroundColor="#76B66A" />
                                            <BoxView Grid.Column="2" HeightRequest="91" VerticalOptions="End" BackgroundColor="#76B66A" />
                                            <BoxView Grid.Column="3" HeightRequest="145" VerticalOptions="End" BackgroundColor="#76B66A" />
                                            <BoxView Grid.Column="4" HeightRequest="108" VerticalOptions="End" BackgroundColor="#76B66A" />
                                            <BoxView Grid.Column="5" HeightRequest="128" VerticalOptions="End" BackgroundColor="#76B66A" />
                                            <BoxView Grid.Column="6" HeightRequest="95" VerticalOptions="End" BackgroundColor="#76B66A" />
                                        </Grid>
                                    </Grid>
                                </Grid>
                                <Grid ColumnDefinitions="42,*,*,*,*,*,*,*" ColumnSpacing="0">
                                    <Label Grid.Column="1" Text="Mon" FontSize="16" TextColor="#929C96" />
                                    <Label Grid.Column="2" Text="Tue" FontSize="16" TextColor="#929C96" />
                                    <Label Grid.Column="3" Text="Wed" FontSize="16" TextColor="#929C96" />
                                    <Label Grid.Column="4" Text="Thu" FontSize="16" TextColor="#929C96" />
                                    <Label Grid.Column="5" Text="Fri" FontSize="16" TextColor="#929C96" />
                                    <Label Grid.Column="6" Text="Sat" FontSize="16" TextColor="#929C96" />
                                    <Label Grid.Column="7" Text="Sun" FontSize="16" TextColor="#929C96" HorizontalTextAlignment="End" />
                                </Grid>
                            </VerticalStackLayout>
                        </Border>

                        <Border Grid.Column="1" Style="{StaticResource DashboardCardStyle}">
                            <VerticalStackLayout Spacing="10">
                                <Grid ColumnDefinitions="*">
                                    <Label Text="ORDERS" FontSize="16" CharacterSpacing="0.8"
                                           TextColor="#536159" FontAttributes="Bold" />
                                </Grid>
                                <Label Text="24" FontSize="29" TextColor="#202923" />
                                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                                    <VerticalStackLayout Spacing="4">
                                        <Label Text="Delivery" FontSize="15" TextColor="#65716A" />
                                        <Label Text="16  ━━━━━" FontSize="15" TextColor="#E77D28" />
                                        <Label Text="65%" FontSize="16" TextColor="#929C96" />
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Column="1" Spacing="4">
                                        <Label Text="Dine-in" FontSize="15" TextColor="#65716A" />
                                        <Label Text="7  ━━━" FontSize="15" TextColor="#D9B52E" />
                                        <Label Text="30%" FontSize="16" TextColor="#929C96" />
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Column="2" Spacing="4">
                                        <Label Text="Takeaway" FontSize="15" TextColor="#65716A" />
                                        <Label Text="1  ━" FontSize="15" TextColor="#4AA65A" />
                                        <Label Text="5%" FontSize="16" TextColor="#929C96" />
                                    </VerticalStackLayout>
                                </Grid>
                                <BoxView HeightRequest="1" Color="#EDF0EE" />
                                <Label Text="RECENT ORDERS" FontSize="15" CharacterSpacing="0.7"
                                       TextColor="#536159" FontAttributes="Bold" />
                                <Grid ColumnDefinitions="1.3*,0.9*,1*,0.85*" ColumnSpacing="6">
                                    <Label Text="Order ID" FontSize="11" TextColor="#9AA39E" />
                                    <Label Grid.Column="1" Text="Qty" FontSize="11" TextColor="#9AA39E" />
                                    <Label Grid.Column="2" Text="Type" FontSize="11" TextColor="#9AA39E" />
                                    <Label Grid.Column="3" Text="Price" FontSize="11" TextColor="#9AA39E" />
                                </Grid>
                                <Grid ColumnDefinitions="1.25*,0.65*,1*,0.75*" ColumnSpacing="4">
                                    <Label Text="◉ OE 69820" FontSize="12" TextColor="#45534A" />
                                    <Label Grid.Column="1" Text="3 items" FontSize="12" TextColor="#45534A" />
                                    <Label Grid.Column="2" Text="Delivery" FontSize="12" TextColor="#45534A" />
                                    <Label Grid.Column="3" Text="$56.5" FontSize="12" TextColor="#45534A" />
                                </Grid>
                                <Grid ColumnDefinitions="1.25*,0.65*,1*,0.75*" ColumnSpacing="4">
