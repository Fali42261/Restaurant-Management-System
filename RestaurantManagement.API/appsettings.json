{
  "App": {
    "Name": "swapDigit API",
    "Database": {
      "ConnectionString": "Server=(localdb)\\MSSQLLocalDB;Database=swapDigitDb;Trusted_Connection=True;TrustServerCertificate=True;",
      "CommandTimeoutSeconds": 30,
      "ConnectionStringDocker": "Server=swapdigit-sql,1433;Database=swapDigitDb;User Id=sa;Password=YOUR_PASSWORD;TrustServerCertificate=True;"
    },
    "Jwt": {
      "Issuer": "swapDigit",
      "Audience": "swapDigit.Clients",
      "SigningKey": "SwapDigit_Key_JWT_SigningKey_2026_Secure",
      "AccessTokenMinutes": 60,
      "RefreshTokenDays": 14
    },
    "Email": {
      "SmtpHost": "",
      "SmtpPort": 587,
      "EnableSsl": true,
      "UserName": "",
      "Password": "",
      "FromEmail": "",
      "FromName": "swapDigit"
    },
    "Cors": { "AllowedOrigins": [ "http://localhost:5173", "https://localhost:7001" ] },
    "FileStorage": { "RootPath": "App_Data/Uploads", "MaxFileSizeMb": 10 },
    "Business": { "CurrencyCode": "INR", "DefaultTaxPercent": 5, "PasswordMinimumLength": 8 }
  },
  "Logging": {
    "LogLevel": { "Default": "Information", "Microsoft.AspNetCore": "Warning" }
  },
  "AllowedHosts": "*"
}